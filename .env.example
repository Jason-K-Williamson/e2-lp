# Copy to .env and fill in values. Never commit .env.

# ── Deploy (required for `npm run deploy` from Cursor/terminal) ──
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Use template: "Edit Cloudflare Workers"
CLOUDFLARE_API_TOKEN=
# Optional — defaults to wrangler.jsonc account_id
# CLOUDFLARE_ACCOUNT_ID=c1d72867c2217c519e52d4d575609eb0

# ── App secrets (already on the Worker via `wrangler secret put`) ──
ADMIN_PASS=
ANTHROPIC_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APIFY_API_TOKEN=

# ── Public (also in wrangler.jsonc vars) ──
PUBLIC_SUPABASE_URL=https://gvttvfheznfllrsgqsfk.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_META_PIXEL_ID=2345764252241076
PUBLIC_META_TEST_EVENT_CODE=
