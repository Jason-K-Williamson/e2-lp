---
import { getAdminClient } from "../../../lib/supabase-admin";
import LeadDetail from "../../../components/admin/LeadDetail";

const adminPass = import.meta.env.ADMIN_PASS;
const cookie = Astro.cookies.get("admin_auth");
const authed = cookie?.value === adminPass;

if (!authed) return Astro.redirect("/admin");

const { id } = Astro.params;

const supabase = getAdminClient();
const { data: lead, error } = await supabase
  .from("leads")
  .select("*, founders(*), outreach(*)")
  .eq("id", id!)
  .single();

if (error || !lead) return Astro.redirect("/admin/leads");
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{lead.brand_name} — e2 Admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      * { box-sizing: border-box; margin: 0; padding: 0; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #f4f5f7;
        color: #111;
        min-height: 100vh;
      }
      .header {
        background: #0f0f0f;
        padding: 0 32px;
        height: 56px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .header-left { display: flex; align-items: center; gap: 20px; }
      .header h1 { font-size: 15px; font-weight: 700; color: #fff; }
      .header-tag {
        font-size: 10px; font-weight: 700; text-transform: uppercase;
        letter-spacing: 0.1em; color: #6366f1;
        background: rgba(99,102,241,.12); padding: 3px 8px; border-radius: 4px;
      }
      .nav { display: flex; gap: 4px; }
      .nav a {
        color: #9ca3af; font-size: 13px; font-weight: 500;
        text-decoration: none; padding: 6px 12px; border-radius: 7px;
        transition: all 0.15s;
      }
      .nav a:hover { color: #fff; background: rgba(255,255,255,.08); }
      .nav a.active { color: #fff; background: rgba(255,255,255,.12); }
      .page { max-width: 1100px; margin: 0 auto; padding: 28px 24px 80px; }
    </style>
  </head>
  <body>
    <div class="header">
      <div class="header-left">
        <a href="/admin" style="text-decoration:none;">
          <h1>e2 Admin</h1>
        </a>
        <span class="header-tag">Internal</span>
        <nav class="nav">
          <a href="/admin">Variants</a>
          <a href="/admin/leads" class="active">Leads</a>
        </nav>
      </div>
    </div>

    <div class="page">
      <LeadDetail
        client:load
        lead={lead}
      />
    </div>
  </body>
</html>
