---
import BaseLayout from "../layouts/BaseLayout.astro";
import StickyNav from "../components/StickyNav.astro";
import Hero from "../components/Hero.astro";
import SocialProof from "../components/SocialProof.astro";
import MajorCaseStudies from "../components/MajorCaseStudies.astro";
import DeliverabilityProof from "../components/DeliverabilityProof.astro";
import EmailGallery from "../components/EmailGallery.astro";
import MinorCaseStudies from "../components/MinorCaseStudies.astro";
import Testimonials from "../components/Testimonials.astro";
import HeroTestimonial from "../components/HeroTestimonial.astro";
import FounderNote from "../components/FounderNote.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
import { supabase } from "../lib/supabase";
import { HOME_COPY } from "../lib/home-copy";
import { getStrategyIntakeCopy } from "../lib/strategy-intake";
import KlaviyoProof from "../components/KlaviyoProof.astro";

const strategyIntake = getStrategyIntakeCopy();

// Live revenue total only — copy lives in src/lib/home-copy.ts
const { data: siteMetric } = await supabase
  .from("site_metrics")
  .select("live_revenue_total")
  .eq("key", "global")
  .maybeSingle();
const featuredRevenue = Number(siteMetric?.live_revenue_total ?? 225669414);
---

<BaseLayout title={HOME_COPY.title} description={HOME_COPY.description} pageVariant="control">
  <StickyNav />

  <Hero
    badge={strategyIntake.primaryLine}
    headline={HOME_COPY.hero_headline}
    subheadline={HOME_COPY.hero_subheadline}
    ctaPrimary={HOME_COPY.hero_cta_primary}
    ctaSecondary={HOME_COPY.hero_cta_secondary}
  />

  <SocialProof featuredRevenue={featuredRevenue} />

  <HeroTestimonial />

  <FounderNote />

  <MajorCaseStudies />

  <DeliverabilityProof />

  <EmailGallery />

  <KlaviyoProof />

  <MinorCaseStudies />

  <Testimonials />

  <FinalCTA
    heading={HOME_COPY.finalcta_heading}
    subheading={HOME_COPY.finalcta_subheading}
  />

  <Footer />
</BaseLayout>
