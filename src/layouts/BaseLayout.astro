---
import { Font } from "astro:assets";
import PostHog from "../components/PostHog.astro";
import MetaPixel from "../components/MetaPixel.astro";
import VisualEditor from "../components/VisualEditor.astro";
import FormflowModal from "../components/FormflowModal.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  variantId?: string;
}

const {
  title,
  description,
  ogImage = "/og-default.jpg",
  variantId,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const isAdmin = !!(Astro.locals as any).isAdmin;
const adminPass = isAdmin ? import.meta.env.ADMIN_PASS : "";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- charset MUST be first — before any scripts or external resources -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!--
      Astro 6 Fonts API:
      - self-hosted + optimized by Astro provider pipeline
      - one unified source of truth (astro.config.mjs)
      - preload enabled for the family used by above-the-fold hero copy
    -->
    <Font cssVariable="--font-dm-sans" preload />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!--
      NOTE: We used to preload /brand/e2-lockup-black.png as the "LCP image".
      PSI revealed the actual LCP element is <h1 id="hero-headline"> (text),
      NOT the logo. That means preloading the logo was *stealing* bandwidth
      from the font fetch that actually blocks LCP (DMSans-700.woff2).
      The logo still loads fast — it's a 4 KB PNG inside the viewport,
      browsers discover it during HTML parse and pipeline it alongside
      the font. Explicit preload hurt more than it helped.
    -->

    <!-- Bunny Stream: dns-prefetch only — avoids PSI “unused preconnect” (posters load lazy / below fold) -->
    <link rel="dns-prefetch" href="https://vz-e4e7db1f-2fb.b-cdn.net" />
    <link rel="dns-prefetch" href="https://iframe.mediadelivery.net" />
    <link rel="dns-prefetch" href="https://assets.mediadelivery.net" />
    <!--
      Formflow = conversion-critical. Upgrade to full preconnect (TCP+TLS warmed)
      so the modal feels instant when users click the CTA. Widget itself is
      prefetched on idle (see end of <body>) so it's in the HTTP cache by the
      time the click happens — modal open becomes an effectively-zero-latency
      event even though the script is 1.4 MB.
    -->
    <link rel="preconnect" href="https://myformflow.io" crossorigin />
    <!--
      Analytics origins — deferred scripts, dns-prefetch is enough.
      PostHog is the source of truth for events; Meta pixel just fires PageView
      browser-side. Server-side Lead → Meta CAPI is handled by PostHog's
      Meta Ads destination (Data pipeline → Destinations in PostHog UI).
    -->
    <link rel="dns-prefetch" href="https://us-assets.i.posthog.com" />
    <link rel="dns-prefetch" href="https://connect.facebook.net" />

    <!-- Tracking: PostHog (source of truth) → Meta CAPI via destinations.
         Meta pixel handles browser-side PageView only. -->
    <PostHog />
    <MetaPixel />

    <!-- Formflow widget.js is injected from FormflowModal.astro on first open only -->

    <!--
      All CSS (global.css + Tailwind) is inlined into this <head> at build time
      via astro.config `build.inlineStylesheets: 'always'`. That guarantees:
        - zero render-blocking stylesheet requests
        - zero cache-miss FOUC on first visit (what we were seeing before)
        - same bytes-on-the-wire after gzip (HTML + inline CSS compresses as well
          as HTML + separate CSS, because the CSS repeats class tokens are hot
          in the gzip window)
      Do NOT re-introduce a hand-written critical-CSS block — it will fight the
      generated one and diverge on every Tailwind change.
    -->
    <style is:global>
      @import "../styles/global.css";
    </style>
  </head>
  <body
    class="min-h-screen overflow-x-hidden"
    data-variant-id={variantId ?? ""}
  >
    <main>
      <slot />
    </main>

    <!-- One global modal: Formflow widget requires #formflow-embed in the document -->
    <FormflowModal />

    {
      isAdmin && (
        <VisualEditor variantId={variantId ?? ""} />
      )
    }

    <!--
      Conversion warm-up: prefetch the Formflow widget during browser idle time
      so the first CTA click opens the modal instantly. Widget is ~1.4 MB so we
      gate the prefetch on:
        - no Save-Data header
        - effective connection type better than 'slow-2g' / '2g'
        - after window.load + requestIdleCallback (never competes with LCP)
      On metered / low-end connections we skip the prefetch entirely — the modal
      still works, it just has to download widget.js on first click.
    -->
    <script is:inline>
      (function () {
        var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
        if (conn) {
          if (conn.saveData) return;
          if (conn.effectiveType === "slow-2g" || conn.effectiveType === "2g") return;
        }
        var warm = function () {
          var l = document.createElement("link");
          l.rel = "prefetch";
          l.href = "https://myformflow.io/embed/widget.js";
          l.as = "script";
          l.crossOrigin = "anonymous";
          document.head.appendChild(l);
        };
        var schedule = function () {
          if ("requestIdleCallback" in window) {
            requestIdleCallback(warm, { timeout: 4000 });
          } else {
            setTimeout(warm, 2500);
          }
        };
        if (document.readyState === "complete") schedule();
        else window.addEventListener("load", schedule, { once: true });
      })();
    </script>

    <!--
      Scroll-triggered reveal + counters.
      ────────────────────────────────────────────────────────────────────
      GSAP (40 KB) was replaced with ~30 lines of vanilla JS:
        1. IntersectionObserver adds `.is-visible` to [data-animate] elements
           as they enter the viewport. CSS handles the fade-in-up transition.
        2. Counters animate once via requestAnimationFrame when visible.
      If IntersectionObserver is unavailable, everything reveals immediately
      (safe graceful degradation). Hero content no longer animates — it
      paints instantly for fastest LCP.
    -->
    <script is:inline>
      (function () {
        var reveal = document.querySelectorAll("[data-animate]");
        var counters = document.querySelectorAll("[data-counter]");

        if (!("IntersectionObserver" in window)) {
          reveal.forEach(function (el) { el.classList.add("is-visible"); });
          counters.forEach(function (el) { el.textContent = el.dataset.counter || el.textContent; });
          return;
        }

        var revealIO = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealIO.unobserve(entry.target);
            }
          });
        }, { rootMargin: "0px 0px -10% 0px", threshold: 0.01 });
        reveal.forEach(function (el) { revealIO.observe(el); });

        function animateCounter(el) {
          var target = el.dataset.counter || "";
          var prefix = (target.match(/^[^0-9]*/) || [""])[0];
          var suffix = (target.match(/[^0-9]*$/) || [""])[0];
          var num = parseFloat(target.replace(/[^0-9.]/g, ""));
          if (isNaN(num)) { el.textContent = target; return; }
          var start = performance.now();
          var duration = 1600;
          function tick(now) {
            var t = Math.min(1, (now - start) / duration);
            var eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
            var v = num * eased;
            el.textContent = prefix + (num >= 100 ? Math.round(v) : v.toFixed(0)) + suffix;
            if (t < 1) requestAnimationFrame(tick);
            else el.textContent = target;
          }
          requestAnimationFrame(tick);
        }

        var counterIO = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              animateCounter(entry.target);
              counterIO.unobserve(entry.target);
            }
          });
        }, { rootMargin: "0px 0px -15% 0px", threshold: 0.01 });
        counters.forEach(function (el) { counterIO.observe(el); });
      })();
    </script>
  </body>
</html>
