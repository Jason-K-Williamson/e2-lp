---
/**
 * Final CTA + GetFormFlow Embed
 * Per 2026 playbook:
 * - Punchy testimonial quote addressing #1 objection
 * - Urgency (spots / intake)
 * - Multi-step form embed (GetFormFlow). NOT a redirect to a standalone URL.
 * - Micro-copy: no contracts, results guaranteed
 */
import { DEFAULT_VARIANT } from "../lib/supabase";
import StrategyCallStatus from "./StrategyCallStatus.astro";

interface Props {
    heading?: string;
    subheading?: string;
}

const {
    heading = DEFAULT_VARIANT.finalcta_heading,
    subheading = DEFAULT_VARIANT.finalcta_subheading,
} = Astro.props;

const isAdmin = !!(Astro.locals as any).isAdmin;
const editProps = (field: string) =>
    isAdmin
        ? {
              contenteditable: "false",
              "data-field": field,
              spellcheck: false as const,
          }
        : {};
---

<section class="py-16 sm:py-32 relative overflow-hidden bg-white">
    <!-- Subtle ambient glow -->
    <div
        class="absolute top-0 left-1/2 -translate-x-1/2 w-[800px] h-[400px] bg-blue-100/40 rounded-full blur-[120px] pointer-events-none"
    >
    </div>

    <div class="section-container relative z-10">
        <!-- Objection-handling testimonial quote , above form -->
        <div class="max-w-2xl mx-auto text-center mb-10 sm:mb-16">
            <blockquote
                class="text-xl sm:text-2xl md:text-3xl font-bold text-gray-900 leading-tight mb-5 sm:mb-6 italic"
            >
                "The team at e2 are experts on Klaviyo and I would highly
                recommend them to any eCommerce store looking to grow fast, make
                a lot of money, and work with good people."
            </blockquote>
            <div class="flex items-center justify-center gap-3">
                <img
                    src="/images/testimonials/pete-james.png"
                    alt="Pete James"
                    width="40"
                    height="40"
                    class="w-10 h-10 rounded-full object-cover ring-2 ring-gray-100 shadow-sm flex-shrink-0"
                    loading="lazy"
                    decoding="async"
                />
                <div class="text-left">
                    <div class="text-gray-900 font-bold text-sm">
                        Pete James
                    </div>
                    <div class="text-gray-600 text-xs">
                        Former Senior Account Executive, Klaviyo
                    </div>
                </div>
            </div>
        </div>

        <!-- Main CTA block -->
        <div class="max-w-2xl mx-auto">
            <!-- Header -->
            <div class="text-center mb-10">
                <!-- Urgency badge -->
                <div
                    class="inline-flex items-center gap-2 px-4 py-2.5 min-h-11 rounded-full bg-amber-50 border border-amber-200 text-amber-800 text-[10px] sm:text-xs font-bold uppercase tracking-widest mb-5 sm:mb-6"
                >
                    <span class="relative flex h-2 w-2">
                        <span
                            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-500 opacity-75"
                            style="will-change: transform;"></span>
                        <span
                            class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"
                        ></span>
                    </span>
                    <StrategyCallStatus surface="finalCta" />
                </div>

                <h2
                    class="font-bold text-3xl sm:text-4xl md:text-5xl text-gray-900 tracking-tight mb-3 sm:mb-4"
                    {...editProps('finalcta_heading')}
                >
                    {heading}
                </h2>
                <p
                    class="text-gray-600 text-lg leading-relaxed"
                    {...editProps('finalcta_subheading')}
                >
                    {subheading}
                </p>
            </div>

            <!-- GetFormFlow Embed: loaded lazily via IntersectionObserver.
                 data-src is swapped to src when the section enters the viewport
                 (or immediately if the user navigates via #qualify anchor). -->
            <div
                id="qualify"
                class="w-full max-w-2xl mx-auto scroll-mt-28 overflow-hidden"
            >
                <iframe
                    id="qualify-frame"
                    data-src="https://myformflow.io/_embed/669116a60dc0431e247ef7a5?form-only"
                    class="block min-h-[580px] w-full border-0 bg-white"
                    title="See if you qualify"
                    allow="clipboard-write"
                ></iframe>
            </div>

            <!-- Micro-copy guarantee strip -->
            <div
                class="mt-6 sm:mt-8 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs text-gray-600"
            >
                <div class="flex items-center gap-1.5">
                    <svg
                        class="w-4 h-4 text-green-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                        ></path>
                    </svg>
                    <span>No contracts</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <svg
                        class="w-4 h-4 text-green-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M5 13l4 4L19 7"></path>
                    </svg>
                    <span>Results guaranteed</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <svg
                        class="w-4 h-4 text-green-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
                        ></path>
                    </svg>
                    <span>You own everything we build</span>
                </div>
                <div class="flex items-center gap-1.5">
                    <svg
                        class="w-4 h-4 text-green-500"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"
                        ></path>
                    </svg>
                    <span>Live in 21 days</span>
                </div>
            </div>
        </div>
    </div>
</section>

<script is:inline>
  (function () {
    var frame = document.getElementById("qualify-frame");
    if (!frame) return;

    function loadFrame() {
      if (frame.src) return; // already loaded
      var src = frame.getAttribute("data-src");
      if (src) frame.src = src;
    }

    // Load immediately if #qualify is in the URL (hash navigation)
    if (window.location.hash === "#qualify") {
      loadFrame();
    } else if ("IntersectionObserver" in window) {
      var io = new IntersectionObserver(function (entries) {
        if (entries[0].isIntersecting) {
          loadFrame();
          io.disconnect();
        }
      }, { rootMargin: "200px" });
      io.observe(frame);
    } else {
      // Fallback for old browsers
      loadFrame();
    }

    // ── Formflow postMessage handler ─────────────────────────────────────────
    // Handles both the iframe resize protocol AND form-submission detection
    // for PostHog Lead capture (which forwards to Meta CAPI via PostHog's
    // destinations feature).
    //
    // Formflow does NOT publicly document a client-side postMessage contract
    // for submissions, so we listen defensively for a range of likely event
    // names and inspect payload shape. Any unknown messages are logged (dev
    // only) so we can tighten the matcher later.
    //
    // Dedup: we only fire Lead once per page session to avoid counting
    // multi-step navigation events as duplicate conversions.
    var leadFired = false;
    var isDev =
      location.hostname === "localhost" ||
      location.hostname === "127.0.0.1" ||
      location.hostname.endsWith(".workers.dev");

    window.addEventListener(
      "message",
      function (e) {
        if (e.origin !== "https://myformflow.io") return;
        var data = e.data || {};

        // 1) Resize protocol — keep existing behaviour.
        if (data.event === "resize" && data.height) {
          frame.style.height = data.height + "px";
          return;
        }

        // 2) Submission detection — catch common event-name conventions.
        var eventName = (data.event || data.type || data.name || "")
          .toString()
          .toLowerCase();
        var looksLikeSubmit =
          /submit|complete|complet|finish|success|done|thank|conversion|lead/i.test(
            eventName
          );

        if (looksLikeSubmit && !leadFired) {
          leadFired = true;

          // Extract any identifying fields we can find in the payload.
          // Formflow payloads (when present) typically include `fields` or
          // `answers` with user input. We search defensively across keys.
          var email = findField(data, [
            "email",
            "email_address",
            "e_mail",
            "emailAddress",
          ]);
          var phone = findField(data, [
            "phone",
            "phone_number",
            "mobile",
            "telephone",
            "tel",
          ]);
          var firstName = findField(data, [
            "first_name",
            "firstName",
            "fname",
            "given_name",
          ]);
          var lastName = findField(data, [
            "last_name",
            "lastName",
            "lname",
            "family_name",
            "surname",
          ]);
          var company = findField(data, [
            "company",
            "company_name",
            "business",
            "brand",
          ]);

          // Identify the user in PostHog BEFORE capturing Lead so the event
          // carries person properties (email, phone → hashed by PostHog's
          // Meta CAPI destination for advanced matching).
          if (window.posthog) {
            try {
              if (email) {
                window.posthog.identify(email, {
                  email: email,
                  phone: phone || undefined,
                  first_name: firstName || undefined,
                  last_name: lastName || undefined,
                  company: company || undefined,
                });
              }
              window.posthog.capture("Lead", {
                form_id: "formflow:669116a60dc0431e247ef7a5",
                form_source: "final_cta",
                email: email || undefined,
                phone: phone || undefined,
                first_name: firstName || undefined,
                last_name: lastName || undefined,
                company: company || undefined,
                $set: {
                  last_lead_submitted_at: new Date().toISOString(),
                },
              });
            } catch (err) {
              if (isDev) console.warn("PostHog Lead capture failed:", err);
            }
          }

          // Fire browser-side Meta Pixel Lead too, for redundancy against
          // PostHog CAPI outages. PostHog's Meta destination dedupes on
          // event_id, but since we're not passing one, we accept a small
          // amount of double-counting on Lead in exchange for resilience.
          // (Lead CPA in Meta is calculated from CAPI-preferred, so browser
          // dupes are discounted automatically.)
          if (window.fbq) {
            try {
              window.fbq("track", "Lead", {
                content_name: "Qualification Call",
              });
            } catch (_) {}
          }
        }

        if (isDev && !looksLikeSubmit && data.event !== "resize") {
          console.log("[Formflow] unknown message:", data);
        }
      },
      false
    );

    // Small helper: find the first non-empty value in an object for a list
    // of possible keys (case-insensitive, searches 1 level deep into `fields`,
    // `answers`, `data`, `payload`).
    function findField(obj, keys) {
      if (!obj || typeof obj !== "object") return null;
      var pools = [obj];
      ["fields", "answers", "data", "payload", "form", "submission"].forEach(
        function (k) {
          if (obj[k] && typeof obj[k] === "object") pools.push(obj[k]);
        }
      );
      for (var i = 0; i < pools.length; i++) {
        var src = pools[i];
        for (var j = 0; j < keys.length; j++) {
          var k = keys[j];
          // Direct lowercase
          if (src[k] != null && src[k] !== "") return String(src[k]);
          // Case-insensitive scan
          for (var prop in src) {
            if (
              Object.prototype.hasOwnProperty.call(src, prop) &&
              prop.toLowerCase() === k.toLowerCase() &&
              src[prop] != null &&
              src[prop] !== ""
            ) {
              return String(src[prop]);
            }
          }
        }
      }
      return null;
    }

    // Also load if user clicks #qualify anchor.
    document.addEventListener("click", function (e) {
      var el = e.target && e.target.closest('a[href="#qualify"]');
      if (el) loadFrame();
    });
  })();
</script>
