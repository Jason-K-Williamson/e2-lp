---
/**
 * FlowHero — Hero section for Flow Build-Outs educational page
 * Scroll-triggered storytelling pattern with strong CRO hooks
 */
import { APPLY_URL } from "../lib/apply-url";
---

<section class="relative min-h-screen flex flex-col justify-center pt-16 pb-24 overflow-hidden bg-e2-black">
  <!-- Ambient layered background -->
  <div class="absolute inset-0 pointer-events-none">
    <div style="background: radial-gradient(ellipse 80% 60% at 20% 10%, rgba(99,102,241,0.18) 0%, transparent 60%); position:absolute; inset:0;"></div>
    <div style="background: radial-gradient(ellipse 60% 50% at 80% 90%, rgba(139,92,246,0.12) 0%, transparent 55%); position:absolute; inset:0;"></div>
    <div style="background: radial-gradient(ellipse 40% 35% at 50% 50%, rgba(59,130,246,0.08) 0%, transparent 70%); position:absolute; inset:0;"></div>
    <!-- Grid overlay -->
    <div style="background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 60px 60px; position:absolute; inset:0;"></div>
  </div>

  <div class="section-container relative z-10 flex flex-col items-center text-center">

    <!-- Trust badge -->
    <div
      
      class="inline-flex items-center gap-2.5 px-5 py-2.5 rounded-full border border-indigo-500/30 bg-indigo-500/10 backdrop-blur-md text-xs font-bold text-indigo-300 mb-10 tracking-widest uppercase"
    >
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-indigo-400 opacity-75" style="will-change: transform;"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-indigo-400"></span>
      </span>
      Custom Flow Build-Outs
    </div>

    <!-- Headline -->
    <h1
      id="flow-hero-headline"
      
      class="max-w-4xl font-bold text-[clamp(2.2rem,5vw,4rem)] leading-[1.05] tracking-tight text-white mb-6 text-balance"
    >
      The Complete Email and SMS
      <br />
      <span class="text-transparent bg-clip-text" style="background-image: linear-gradient(135deg, #818cf8, #c084fc, #60a5fa);">
        Flow System
      </span>
      Built for Your Brand.
    </h1>

    <!-- Subheadline -->
    <p
      
      class="text-base md:text-xl text-slate-400 max-w-2xl mx-auto mb-10 leading-relaxed font-normal text-balance"
    >
      We custom-build every flow from scratch. Welcome series, every stage of abandonment, and a retention engine
      that turns one-time buyers into lifetime brand believers.
    </p>

    <!-- CTA group -->
    <div
      
      class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto mb-5"
    >
      <a
        href={APPLY_URL}
        id="flow-hero-cta"
        data-apply-cta="flow-hero"
        class="group w-full sm:w-auto px-10 py-4 rounded-full font-bold text-lg text-e2-black transition-all duration-300 shadow-2xl flex items-center justify-center gap-2 relative overflow-hidden cursor-pointer"
        style="background: linear-gradient(135deg, #818cf8, #a78bfa, #60a5fa);"
      >
        <span class="relative z-10">See If You Qualify</span>
        <svg class="w-5 h-5 relative z-10 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a
        href="#flows-overview"
        class="w-full sm:w-auto px-8 py-4 bg-white/5 backdrop-blur-sm text-white border border-white/10 rounded-full font-semibold text-lg hover:bg-white/10 hover:border-white/20 transition-all duration-300 cursor-pointer text-center"
      >
        See Every Flow
      </a>
    </div>

    <!-- Micro trust -->
    <p  class="text-xs text-slate-500 font-medium tracking-wide mb-16">
      100% custom built&nbsp;·&nbsp;You own everything&nbsp;·&nbsp;Live in 21 days
    </p>

    <!-- Hero proof metrics strip -->
    <div
      
      class="w-full max-w-3xl grid grid-cols-2 md:grid-cols-4 gap-4"
    >
      {[
        { value: "$225M+", label: "Revenue Generated" },
        { value: "2,000+", label: "Brands Served" },
        { value: "48%", label: "Avg. Revenue from Email" },
        { value: "21 days", label: "To Go Live" },
      ].map((stat) => (
        <div class="flex flex-col items-center p-5 rounded-2xl border border-white/8 bg-white/4 backdrop-blur-sm hover:bg-white/7 transition-colors duration-300">
          <span class="text-2xl md:text-3xl font-bold text-white mb-1">{stat.value}</span>
          <span class="text-xs text-slate-500 font-medium text-center leading-tight">{stat.label}</span>
        </div>
      ))}
    </div>

  </div>
</section>
