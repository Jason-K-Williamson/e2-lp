---
import BunnyVideo from "./video/BunnyVideo.astro";
/**
 * MajorCaseStudies — 5 full-width hero case study cards
 * Extracted from CaseStudies.astro so /2 can use them independently.
 */
---

<section id="major-case-studies" class="py-32 relative overflow-hidden">
    <div
        class="absolute inset-0 bg-gradient-to-b from-gray-950 to-gray-950 pointer-events-none"
    >
    </div>
    <!-- Ambient glows -->
    <div
        class="absolute top-0 left-1/4 w-[600px] h-[600px] bg-blue-600/10 rounded-full blur-[120px] pointer-events-none"
    >
    </div>
    <div
        class="absolute bottom-0 right-1/4 w-[400px] h-[400px] bg-indigo-600/10 rounded-full blur-[100px] pointer-events-none"
    >
    </div>

    <div class="section-container relative z-10">
        <!-- Header -->
        <div class="max-w-3xl mx-auto text-center mb-16">
            <p
                class="text-xs font-bold uppercase tracking-widest text-blue-400 mb-4"
            >
                Proof
            </p>
            <h2
                class="font-bold text-4xl md:text-5xl mb-6 text-white tracking-tight text-balance"
            >
                Real Numbers.<br />
                <span class="text-gray-300">Real Brands. Real Revenue.</span>
            </h2>
            <p class="text-xl text-gray-300 leading-relaxed text-balance">
                Every result below is verified. Every number came from a Klaviyo
                or Shopify dashboard.
            </p>
        </div>

        <!-- Hero Case Study — Matt Orlic / Inspire Brands -->
        <div class="mb-12">
            <div
                class="rounded-[3rem] border border-white/10 bg-white/5 backdrop-blur-sm p-10 md:p-16 relative overflow-hidden"
            >
                <!-- Inner glow — orange/growth accent -->
                <div
                    class="absolute top-0 right-0 w-96 h-96 bg-orange-500/10 rounded-full blur-[80px] -mr-48 -mt-48 pointer-events-none"
                >
                </div>

                <div
                    class="relative z-10 grid md:grid-cols-2 gap-12 items-center"
                >
                    <!-- Left: story + quote -->
                    <div>
                        <div
                            class="inline-block px-3 py-1.5 rounded-full bg-orange-500/20 border border-orange-500/30 text-orange-400 text-xs font-bold uppercase tracking-widest mb-6"
                        >
                            8-Figure Multi-Brand Results
                        </div>

                        <!-- Before → After -->
                        <div class="flex items-center gap-4 mb-8">
                            <div class="text-center">
                                <div
                                    class="text-4xl font-black text-gray-400 tracking-tight"
                                >
                                    17%
                                </div>
                                <div
                                    class="text-xs text-gray-600 font-semibold uppercase tracking-wide mt-1"
                                >
                                    Before
                                </div>
                            </div>
                            <div
                                class="flex-1 flex items-center justify-center"
                            >
                                <div
                                    class="w-full h-px bg-gradient-to-r from-gray-700 via-orange-500 to-gray-700"
                                >
                                </div>
                                <div
                                    class="absolute px-3 py-1 rounded-full bg-orange-500/20 border border-orange-500/30 text-orange-400 text-sm font-black whitespace-nowrap"
                                >
                                    +80%
                                </div>
                            </div>
                            <div class="text-center">
                                <div
                                    class="text-4xl font-black text-white tracking-tight"
                                >
                                    30%+
                                </div>
                                <div
                                    class="text-xs text-gray-300 font-semibold uppercase tracking-wide mt-1"
                                >
                                    After
                                </div>
                            </div>
                        </div>

                        <p
                            class="text-sm font-bold text-gray-400 uppercase tracking-wide mb-6"
                        >
                            Email revenue share · 90 days · rolled out across
                            all 8-figure brands
                        </p>

                        <blockquote
                            class="text-xl text-gray-300 leading-relaxed mb-8 italic"
                        >
                            "We were hovering around 16-17%. Now we're over 30
                            and you can't express what a massive difference that
                            makes in an eCommerce business. One campaign - we
                            achieved $100,000 in a single day just via email.
                            The investment we paid back within the first week
                            alone."
                        </blockquote>

                        <div class="flex items-center gap-4">
                            <div
                                class="w-12 h-12 rounded-full bg-gradient-to-br from-orange-900 to-gray-900 border border-orange-500/20 flex items-center justify-center text-orange-400 text-sm font-black flex-shrink-0"
                            >
                                M
                            </div>
                            <div>
                                <div class="font-bold text-white">
                                    Matt Orlic
                                </div>
                                <div class="text-sm text-gray-300">
                                    Founder · Inspire Brands (8-Figure eCom)
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col gap-4">
                        <BunnyVideo
                            libraryId="609841"
                            videoId="b1589b6d-f62d-4ab2-b4db-ba2711e36f33"
                            title="How Inspire Brands Grew Email Revenue Across Multiple 8-Figure Stores"
                            subtitle="Matt Orlic · Founder, Inspire Brands"
                            author="Matt Orlic"
                            authorRole="Founder, Inspire Brands"
                        />
                        <div class="grid grid-cols-3 gap-3 text-center">
                            <div
                                class="rounded-xl bg-white/5 border border-white/10 p-4"
                            >
                                <div
                                    class="text-2xl font-black text-orange-400"
                                >
                                    $100k
                                </div>
                                <div
                                    class="text-xs text-gray-400 uppercase font-semibold tracking-wide mt-1"
                                >
                                    Single campaign day
                                </div>
                            </div>
                            <div
                                class="rounded-xl bg-white/5 border border-white/10 p-4"
                            >
                                <div class="text-2xl font-black text-white">
                                    90
                                </div>
                                <div
                                    class="text-xs text-gray-400 uppercase font-semibold tracking-wide mt-1"
                                >
                                    Days
                                </div>
                            </div>
                            <div
                                class="rounded-xl bg-white/5 border border-white/10 p-4"
                            >
                                <div class="text-2xl font-black text-white">
                                    8-fig
                                </div>
                                <div
                                    class="text-xs text-gray-400 uppercase font-semibold tracking-wide mt-1"
                                >
                                    Brand scale
                                </div>
                            </div>
                        </div>
                        <p class="text-xs text-gray-600 italic text-center">
                            Results verified · implemented across multiple eCom
                            brands
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hero Case Study #2 — BogeyBros -->

        <div class="mb-12">
            <div
                class="rounded-[3rem] border border-white/10 bg-white/5 backdrop-blur-sm p-10 md:p-16 relative overflow-hidden"
            >
                <!-- Inner glow — green/golf accent -->
                <div
                    class="absolute top-0 right-0 w-96 h-96 bg-emerald-500/10 rounded-full blur-[80px] -mr-48 -mt-48 pointer-events-none"
                >
                </div>

                <div
                    class="relative z-10 grid md:grid-cols-2 gap-12 items-center"
                >
                    <!-- Left: story + quote -->
                    <div>
                        <div
                            class="inline-block px-3 py-1.5 rounded-full bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-widest mb-6"
                        >
                            The Email Frequency Build
                        </div>

                        <!-- Before → After (matches Ryan transcript: frequency + ~100% attributed lift) -->
                        <div class="flex items-center gap-3 sm:gap-4 mb-8">
                            <div class="text-center min-w-0 flex-1">
                                <div
                                    class="text-3xl sm:text-4xl font-black text-gray-400 tracking-tight tabular-nums"
                                >
                                    6–8
                                </div>
                                <div
                                    class="text-[10px] sm:text-xs text-gray-500 font-semibold uppercase tracking-wide mt-1"
                                >
                                    Emails / mo
                                </div>
                                <div
                                    class="text-xs text-gray-600 font-semibold uppercase tracking-wide mt-1"
                                >
                                    Before
                                </div>
                            </div>
                            <div
                                class="flex-1 flex items-center justify-center relative min-w-[4rem]"
                            >
                                <div
                                    class="w-full h-px bg-gradient-to-r from-gray-700 via-emerald-500 to-gray-700"
                                >
                                </div>
                                <div
                                    class="absolute px-2.5 sm:px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 text-xs sm:text-sm font-black whitespace-nowrap text-center leading-tight"
                                >
                                    ~100%
                                    <span
                                        class="block text-[9px] sm:text-[10px] font-bold text-emerald-400/90 normal-case tracking-normal"
                                        >attrib. rev. ↑</span
                                    >
                                </div>
                            </div>
                            <div class="text-center min-w-0 flex-1">
                                <div
                                    class="text-3xl sm:text-4xl font-black text-white tracking-tight"
                                >
                                    20+
                                </div>
                                <div
                                    class="text-[10px] sm:text-xs text-gray-400 font-semibold uppercase tracking-wide mt-1"
                                >
                                    Emails / mo
                                </div>
                                <div
                                    class="text-xs text-gray-300 font-semibold uppercase tracking-wide mt-1"
                                >
                                    After
                                </div>
                            </div>
                        </div>

                        <p
                            class="text-sm font-bold text-gray-400 uppercase tracking-wide mb-6"
                        >
                            ~100% attributed revenue lift · 6–8 → 20+ emails/mo
                            · &lt;90 days · Klaviyo
                        </p>

                        <blockquote
                            class="text-xl text-gray-300 leading-relaxed mb-8 italic"
                        >
                            "I'd definitely recommend e2. Jason and his whole
                            team has been incredible. The communication is
                            great. We've got a Slack channel — tons of resources
                            pouring into our email strategy. Our results have
                            been really good. Attributed revenue is up about 100%
                            from where we were before. We were only sending six
                            to eight emails a month and now we're up to 20 or so
                            plus. The professionalism has been amazing."
                        </blockquote>

                        <div class="flex items-center gap-4">
                            <div
                                class="w-12 h-12 rounded-full bg-gradient-to-br from-emerald-900 to-gray-900 border border-emerald-500/20 flex items-center justify-center text-emerald-400 text-sm font-black flex-shrink-0"
                            >
                                R
                            </div>
                            <div>
                                <div class="font-bold text-white">
                                    Ryan Rizos
                                </div>
                                <div class="text-sm text-gray-300">
                                    Co-Founder &amp; CEO · BogeyBros
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col gap-4">
                        <BunnyVideo
                            libraryId="609841"
                            videoId="6f0c1382-ddd8-40f8-b4d4-f7e3a684f3e0"
                            title="How We Doubled BogeyBros Email Revenue in 90 Days"
                            subtitle="Ryan Rizos · Co-Founder & CEO, BogeyBros"
                            author="Ryan Rizos"
                            authorRole="Co-Founder & CEO, BogeyBros"
                        />
                        <div class="grid grid-cols-3 gap-3 text-center">
                            <div
                                class="rounded-xl bg-white/5 border border-white/10 p-4"
                            >
                                <div
                                    class="text-2xl font-black text-emerald-400"
                                >
                                    ~100%
                                </div>
                                <div
                                    class="text-xs text-gray-400 uppercase font-semibold tracking-wide mt-1"
                                >
                                    Attrib. revenue ↑
                                </div>
                            </div>
                            <div
                                class="rounded-xl bg-white/5 border border-white/10 p-4"
                            >
                                <div class="text-2xl font-black text-white">
                                    20+
                                </div>
                                <div
                                    class="text-xs text-gray-400 uppercase font-semibold tracking-wide mt-1"
                                >
                                    Emails/mo
                                </div>
                            </div>
                            <div
                                class="rounded-xl bg-white/5 border border-white/10 p-4"
                            >
                                <div
                                    class="text-2xl font-black text-emerald-400"
                                >
                                    &lt;90
                                </div>
                                <div
                                    class="text-xs text-gray-400 uppercase font-semibold tracking-wide mt-1"
                                >
                                    Days
                                </div>
                            </div>
                        </div>
                        <p class="text-xs text-gray-600 italic text-center">
                            Results verified via Klaviyo dashboard
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Daily Mentor — Morgan (Head of Mentorship, current) + KC (former CEO, exited QALO) -->
        <div class="mb-12">
            <div
                class="rounded-[3rem] border border-white/10 bg-white/5 backdrop-blur-sm p-10 md:p-16 relative overflow-hidden"
            >
                <div
                    class="absolute top-0 left-0 w-96 h-96 bg-sky-500/10 rounded-full blur-[80px] -ml-48 -mt-48 pointer-events-none"
                >
                </div>
                <div
                    class="absolute bottom-0 right-0 w-80 h-80 bg-indigo-500/10 rounded-full blur-[90px] pointer-events-none"
                >
                </div>

                <div class="relative z-10">
                    <div class="max-w-3xl mx-auto text-center mb-10 md:mb-12">
                        <div
                            class="inline-block px-3 py-1.5 rounded-full bg-sky-500/20 border border-sky-500/30 text-sky-300 text-xs font-bold uppercase tracking-widest mb-6"
                        >
                            Daily Mentor · Community proof
                        </div>
                        <div
                            class="flex flex-wrap items-center justify-center gap-4 mb-6"
                        >
                            <img
                                src="/brand-logos/daily-mentor.avif"
                                alt="The Daily Mentor"
                                width="160"
                                height="60"
                                class="h-9 w-auto opacity-95"
                                loading="lazy"
                                decoding="async"
                            />
                        </div>
                        <p
                            class="text-lg text-gray-300 leading-relaxed text-balance"
                        >
                            <strong class="font-semibold text-white"
                                >The Daily Mentor</strong
                            >
                            is a private mentorship for serious eCom founders
                            (typically $1M+). These two quotes matter because
                            they come from <strong class="font-semibold text-white"
                                >the people who've actually led that program</strong
                            >: Morgan is <strong class="font-semibold text-white"
                                >Head of Mentorship today</strong
                            >— he runs the mentor bench and day-to-day member
                            experience. KC was <strong
                                class="font-semibold text-white"
                                >CEO of Daily Mentor</strong
                            >
                            while scaling the community; he's since moved on
                            (after building &amp; exiting QALO®) and still
                            stands behind Jason's work with members.
                        </p>
                    </div>

                    <div
                        class="grid md:grid-cols-2 gap-10 md:gap-12 items-start"
                    >
                        <!-- Morgan Buckley -->
                        <div
                            class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 md:p-8 flex flex-col h-full"
                        >
                            <div
                                class="flex flex-wrap items-center gap-3 mb-5"
                            >
                                <img
                                    src="/brand-logos/shopify.svg"
                                    alt="Shopify"
                                    width="96"
                                    height="96"
                                    class="h-8 w-auto opacity-95"
                                    loading="lazy"
                                    decoding="async"
                                />
                                <span
                                    class="text-xs text-gray-500 font-semibold uppercase tracking-wider"
                                    >8+ yrs</span
                                >
                            </div>
                            <div class="mb-4">
                                <div class="font-bold text-white text-lg">
                                    Morgan Buckley
                                </div>
                                <p
                                    class="text-sm text-gray-400 mt-1 leading-snug"
                                >
                                    <span class="text-gray-300 font-medium"
                                        >Head of Mentorship, The Daily Mentor</span
                                    >
                                    · Former Senior Merchant Success Manager,
                                    Shopify — VIP &amp; enterprise brands
                                    (including MrBeast, Budweiser &amp; Barstool
                                    Sports)
                                </p>
                            </div>
                            <blockquote
                                class="text-base md:text-lg text-gray-300 leading-relaxed italic flex-1"
                            >
                                "I've been working with Jason and the e2 agency
                                team for over 18 months now, and the experience
                                has been nothing short of excellent. Jason
                                genuinely understands the eCommerce email space at
                                a deep level, not just the technical side, but
                                the strategy behind building flows and campaigns
                                that actually drive revenue. What sets Jason
                                apart is his consistency and reliability. He
                                shows up, delivers, and communicates clearly,
                                which honestly is rarer than it should be. Over
                                our time working together he's become a trusted
                                partner, not just a service provider. If you're
                                an eCommerce brand looking for an email marketing
                                partner who knows what they're doing and actually
                                cares about your results, I'd recommend Jason and
                                the e2 team without hesitation."
                            </blockquote>
                        </div>

                        <!-- KC Holiday -->
                        <div
                            class="rounded-2xl border border-white/10 bg-white/[0.03] p-6 md:p-8 flex flex-col h-full"
                        >
                            <div
                                class="flex flex-wrap items-center gap-3 mb-5"
                            >
                                <span
                                    class="inline-flex items-center rounded-lg bg-white/10 px-2.5 py-1 text-[11px] font-black tracking-wide text-white border border-white/15"
                                    >QALO®</span
                                >
                                <span
                                    class="text-xs text-gray-500 font-semibold uppercase tracking-wider"
                                    >Exited</span
                                >
                            </div>
                            <div class="mb-4">
                                <div class="font-bold text-white text-lg">
                                    KC Holiday
                                </div>
                                <p
                                    class="text-sm text-gray-400 mt-1 leading-snug"
                                >
                                    <span class="text-gray-300 font-medium"
                                        >Former CEO, The Daily Mentor</span
                                    >
                                    · Co-founder of QALO® (built &amp; exited) ·
                                    Founder, Cashmere Wolf
                                </p>
                            </div>
                            <blockquote
                                class="text-base md:text-lg text-gray-300 leading-relaxed italic flex-1"
                            >
                                "Jason has been advising brands inside The Daily
                                Mentor community for 6 months now, and I don't
                                think there's a better person to help founders
                                grow their brands through email and SMS. His
                                knowledge is incredible, but he doesn't just
                                advise from a distance — he gets his hands dirty
                                coaching founders not just on what to do, but how
                                to do it. The results founders are getting is
                                WILD. Highly recommended from the whole Daily
                                Mentor crew 🙌🏻"
                            </blockquote>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hero Case Study #3 — Canvas Cultures -->
        <div class="mb-12">
            <div
                class="rounded-[3rem] border border-white/10 bg-white/5 backdrop-blur-sm p-10 md:p-16 relative overflow-hidden"
            >
                <div
                    class="absolute top-0 left-0 w-96 h-96 bg-violet-500/10 rounded-full blur-[80px] -ml-48 -mt-48 pointer-events-none"
                >
                </div>

                <div
                    class="relative z-10 grid md:grid-cols-2 gap-12 items-center"
                >
                    <!-- Left: story + quote -->
                    <div>
                        <div
                            class="inline-block px-3 py-1.5 rounded-full bg-violet-500/20 border border-violet-500/30 text-violet-400 text-xs font-bold uppercase tracking-widest mb-6"
                        >
                            The 8-Year Partnership
                        </div>

                        <div class="flex items-center gap-4 mb-8">
                            <div class="text-center">
                                <div
                                    class="text-4xl font-black text-gray-400 tracking-tight"
                                >
                                    $100k
                                </div>
                                <div
                                    class="text-xs text-gray-600 font-semibold uppercase tracking-wide mt-1"
                                >
                                    Month 1
                                </div>
                            </div>
                            <div
                                class="flex-1 flex items-center justify-center"
                            >
                                <div
                                    class="w-full h-px bg-gradient-to-r from-gray-700 via-violet-500 to-gray-700"
                                >
                                </div>
                                <div
                                    class="absolute px-3 py-1 rounded-full bg-violet-500/20 border border-violet-500/30 text-violet-400 text-sm font-black whitespace-nowrap"
                                >
                                    15×
                                </div>
                            </div>
                            <div class="text-center">
                                <div
                                    class="text-4xl font-black text-white tracking-tight"
                                >
                                    $1.5M
                                </div>
                                <div
                                    class="text-xs text-gray-300 font-semibold uppercase tracking-wide mt-1"
                                >
                                    Peak month
                                </div>
                            </div>
                        </div>

                        <p
                            class="text-sm font-bold text-gray-400 uppercase tracking-wide mb-6"
                        >
                            Monthly revenue · 8-year partnership · 7-figure exit
                            in 2021
                        </p>

                        <blockquote
                            class="text-xl text-gray-300 leading-relaxed mb-8 italic"
                        >
                            "I've been knowing Jason for about eight years. He's
                            worked on every project I've had, from $100k a month
                            to $1.5 million a month. I made a seven-figure exit
                            in 2021 with the canvas brand we worked on. Whoever
                            chooses to partner with Jason will be a smart
                            person. I hate doing these things because I feel
                            like I'm giving away my secret weapon."
                        </blockquote>

                        <div class="flex items-center gap-4">
                            <div
                                class="w-12 h-12 rounded-full bg-gradient-to-br from-violet-900 to-gray-900 border border-violet-500/20 flex items-center justify-center text-violet-400 text-sm font-black flex-shrink-0"
                            >
                                J
                            </div>
                            <div>
                                <div class="font-bold text-white">
                                    Joshua Tatum
                                </div>
                                <div class="text-sm text-gray-300">
                                    Founder · Canvas Cultures
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col gap-4">
                        <BunnyVideo
                            libraryId="609841"
                            videoId="8d955164-4635-4902-899a-2ab1a15bb575"
                            title="Canvas Cultures: From $100k to $1.5M/Month"
                            subtitle="Joshua Tatum · Founder, Canvas Cultures"
                            author="Joshua Tatum"
                            authorRole="Founder, Canvas Cultures"
                        />
                        <div class="grid grid-cols-3 gap-3 text-center">
                            <div
                                class="rounded-xl bg-white/5 border border-white/10 p-4"
                            >
                                <div
                                    class="text-2xl font-black text-violet-400"
                                >
                                    15×
                                </div>
                                <div
                                    class="text-xs text-gray-400 uppercase font-semibold tracking-wide mt-1"
                                >
                                    Revenue multiple
                                </div>
                            </div>
                            <div
                                class="rounded-xl bg-white/5 border border-white/10 p-4"
                            >
                                <div class="text-2xl font-black text-white">
                                    7-fig
                                </div>
                                <div
                                    class="text-xs text-gray-400 uppercase font-semibold tracking-wide mt-1"
                                >
                                    Exit 2021
                                </div>
                            </div>
                            <div
                                class="rounded-xl bg-white/5 border border-white/10 p-4"
                            >
                                <div class="text-2xl font-black text-white">
                                    8 yrs
                                </div>
                                <div
                                    class="text-xs text-gray-400 uppercase font-semibold tracking-wide mt-1"
                                >
                                    Partnership
                                </div>
                            </div>
                        </div>
                        <p class="text-xs text-gray-600 italic text-center">
                            Revenue growth verified across multiple brand
                            projects
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Hero Case Study #4 — Nightbuddy (ECOMX) -->
        <div class="mb-12">
            <div
                class="rounded-[3rem] border border-white/10 bg-white/5 backdrop-blur-sm p-10 md:p-16 relative overflow-hidden"
            >
                <div
                    class="absolute bottom-0 left-1/2 -translate-x-1/2 w-96 h-96 bg-amber-500/8 rounded-full blur-[100px] pointer-events-none"
                >
