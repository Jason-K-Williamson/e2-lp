---
/**
 * Social Proof Strip — Credibility anchor immediately below Hero
 * Per 2026 playbook: 4-5 hard metrics, DocSend-style stat bar
 * "Earns the right" for every claim that follows
 */
const supporting = [
  { value: "2,000+", label: "Brands Helped" },
  { value: "750+", label: "Active Retainers" },
  { value: "21 Days", label: "Avg. Flows Live" },
  { value: "31%+", label: "Avg. Klaviyo Revenue" },
];
---

<section class="py-12 sm:py-14 relative z-10 border-y border-gray-100/80">
  <div class="section-container">
    <!-- Featured revenue number -->
    <div class="text-center mb-8 sm:mb-10">
      <div
        class="font-black text-4xl sm:text-5xl md:text-6xl text-e2-black tracking-tight tabular-nums mb-2"
      >
        $225,669,414
      </div>
      <div
        class="text-xs text-gray-400 font-semibold uppercase tracking-widest"
      >
        Revenue Generated for Clients
      </div>
    </div>

    <!-- 4 supporting stats — divide-x handles all borders cleanly -->
    <div
      class="grid grid-cols-2 md:grid-cols-4 divide-x divide-gray-100 border-t border-gray-100 pt-6 sm:pt-8"
    >
      {
        supporting.map((stat) => (
          <div class="text-center px-3 sm:px-6 py-2 sm:py-3">
            <div class="font-black text-2xl sm:text-3xl md:text-4xl text-e2-black tracking-tight tabular-nums mb-0.5 sm:mb-1">
              {stat.value}
            </div>
            <div class="text-[10px] sm:text-xs text-gray-400 font-semibold uppercase tracking-wider leading-snug">
              {stat.label}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
