---
/**
 * Static Astro LogoCloud — replaces the React client:load version.
 * No JS hydration, no React runtime, images rendered at build time.
 */
type Logo = {
  src?: string;
  alt: string;
  invert?: boolean;
  width?: number;
  height?: number;
};

const logos: Logo[] = [
  { src: "/brand-logos/the-oodie.webp",        alt: "The Oodie",      width: 140, height: 53  },
  { src: "/brand-logos/twosvge.webp",           alt: "Twosge",         width: 140, height: 28,  invert: true },
  { src: "/brand-logos/otaa.webp",              alt: "OTAA",           width: 56,  height: 94  },
  { src: "/brand-logos/bogey-bros.webp",        alt: "Bogey Bros",     width: 140, height: 53  },
  { src: "/brand-logos/daily-mentor.avif",      alt: "Daily Mentor",   width: 140, height: 53  },
  { src: "/brand-logos/candyclaws.svg",          alt: "Candy Claws",    width: 140, height: 53,  invert: true },
  { src: "/brand-logos/Atoms_Logo_White 1.svg",  alt: "ATOMS",          width: 140, height: 53,  invert: true },
  { src: "/brand-logos/void.webp",              alt: "VOID",           width: 140, height: 53,  invert: true },
];
---

<div class="relative grid grid-cols-2 md:grid-cols-4">
  {logos.map((logo, i) => {
    const isRightBorderMobile = i % 2 === 0;         // left column in 2-col mobile grid
    const isBottomBorderMobile = i < logos.length - 2; // all but last mobile row
    const isRightBorderDesktop = i % 4 !== 3;        // cols 1-3 in 4-col desktop grid
    const isBottomBorderDesktop = i < 4;             // only top desktop row
    const needsPlusTopRight    = i === 0;
    const needsPlusBottomRight = i === 2;
    const needsPlusBottomLeft  = i === 2;

    const borderClasses = [
      isRightBorderMobile ? "border-r border-black/10" : "",
      isBottomBorderMobile ? "border-b border-black/10" : "",
      isRightBorderDesktop ? "md:border-r md:border-black/10" : "md:border-r-0",
      isBottomBorderDesktop ? "md:border-b md:border-black/10" : "md:border-b-0",
    ].filter(Boolean).join(" ");

    return (
      <div class={`relative flex items-center justify-center bg-white px-6 py-10 md:px-8 md:py-10 ${borderClasses}`}>
        {logo.src ? (
          <img
            alt={logo.alt}
            src={logo.src}
            width={logo.width || 140}
            height={logo.height || 53}
            loading={i < 4 ? "eager" : "lazy"}
            decoding={i < 2 ? "sync" : "async"}
            fetchpriority={i === 0 ? "high" : undefined}
            class={`pointer-events-none h-16 w-auto max-w-[140px] select-none object-contain${logo.invert ? " invert" : ""}`}
          />
        ) : (
          <span class="font-black text-gray-700 text-lg sm:text-xl tracking-tight text-center uppercase">
            {logo.alt}
          </span>
        )}
        {/* Plus icons at grid intersections */}
        {needsPlusTopRight && (
          <svg class="-right-[12.5px] -bottom-[12.5px] absolute z-10 size-6 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M12 5v14M5 12h14"/></svg>
        )}
        {needsPlusBottomRight && (
          <svg class="-right-[12.5px] -bottom-[12.5px] absolute z-10 size-6 text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M12 5v14M5 12h14"/></svg>
        )}
        {needsPlusBottomLeft && (
          <svg class="-bottom-[12.5px] -left-[12.5px] absolute z-10 hidden size-6 md:block text-black" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><path d="M12 5v14M5 12h14"/></svg>
        )}
      </div>
    );
  })}
</div>
