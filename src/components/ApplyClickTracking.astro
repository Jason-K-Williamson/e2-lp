---
/** Delegated click tracking for all apply CTAs (data-apply-cta). */
---

<script is:inline>
  document.addEventListener(
    "click",
    function (e) {
      var el = e.target && e.target.closest("[data-apply-cta]");
      if (!el) return;
      if (window.posthog && window.posthog.capture) {
        window.posthog.capture("Clicked Apply", {
          cta_location: el.getAttribute("data-apply-cta") || "unknown",
        });
      }
    },
    true
  );
</script>
