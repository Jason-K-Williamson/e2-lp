---
/**
 * FlowSummary — "What's Inside" complete deliverables overview
 * Hormozi-style offer stack for all flows
 */

const deliverables = [
  {
    flow: "Flow 1",
    name: "Welcome Series",
    bgGrad: "from-indigo-600 to-violet-600",
    tagColor: "bg-indigo-50 text-indigo-700 border-indigo-100",
    items: [
      { icon: "M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5", label: "1 Custom dual opt-in pop-up (Email + SMS)" },
      { icon: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z", label: "5 Welcome emails custom built for your brand" },
      { icon: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z", label: "3 SMS messages perfectly timed to convert" },
    ],
    total: "9 touchpoints",
  },
  {
    flow: "Flow 2",
    name: "5 Stages of Abandonment",
    bgGrad: "from-orange-500 to-red-500",
    tagColor: "bg-orange-50 text-orange-700 border-orange-100",
    items: [
      { icon: "M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z", label: "5 Abandoned checkout emails" },
      { icon: "M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z", label: "3 Added to cart abandonment emails" },
      { icon: "M15 12a3 3 0 11-6 0 3 3 0 016 0z M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z", label: "3 Browser abandonment emails" },
      { icon: "M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10", label: "2 Collection abandonment emails" },
      { icon: "M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6", label: "1 Site abandonment (home page) email" },
    ],
    total: "14 emails",
  },
  {
    flow: "Flow 3",
    name: "Customer Thank You Series",
    bgGrad: "from-emerald-500 to-teal-600",
    tagColor: "bg-emerald-50 text-emerald-700 border-emerald-100",
    items: [
      { icon: "M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z", label: "6-email retention and loyalty sequence" },
      { icon: "M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z", label: "Automated review request at peak satisfaction" },
      { icon: "M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z", label: "Referral and evangelist activation touchpoint" },
    ],
    total: "6 emails",
  },
];
---

<section class="py-28 relative overflow-hidden" style="background: linear-gradient(180deg, #f8fafc 0%, #f0f4ff 100%);">
  <div class="absolute inset-0 pointer-events-none" style="background-image: radial-gradient(circle at 25% 50%, rgba(99,102,241,0.05) 0%, transparent 50%), radial-gradient(circle at 75% 50%, rgba(16,185,129,0.04) 0%, transparent 50%);"></div>

  <div class="section-container relative z-10">

    <!-- Section header -->
    <div  class="text-center mb-16">
      <h2 class="font-bold text-[clamp(1.8rem,3.5vw,3rem)] leading-tight tracking-tight text-e2-black mb-5 max-w-3xl mx-auto text-balance">
        Everything You Get
      </h2>
      <p class="text-base md:text-lg text-gray-500 max-w-xl mx-auto leading-relaxed">
        One complete, custom-built email and SMS ecosystem. Every flow. Every email. Every touchpoint engineered to convert.
      </p>
    </div>

    <!-- Deliverable cards -->
    <div  class="grid md:grid-cols-3 gap-6 mb-12">
      {deliverables.map((d) => (
        <div class="rounded-2xl border border-gray-200 bg-white shadow-lg shadow-black/4 overflow-hidden hover:shadow-xl hover:shadow-black/6 transition-shadow duration-300 cursor-default flex flex-col">
          <div class={`p-6 bg-gradient-to-br ${d.bgGrad} text-white`}>
            <div class="text-[10px] font-black uppercase tracking-widest opacity-70 mb-2">{d.flow}</div>
            <h3 class="font-bold text-xl leading-tight">{d.name}</h3>
          </div>
          <div class="p-6 flex flex-col flex-1">
            <ul class="space-y-4 flex-1">
              {d.items.map((item) => (
                <li class="flex items-start gap-3">
                  <svg class="w-4 h-4 text-gray-400 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                  </svg>
                  <span class="text-sm text-gray-700 leading-relaxed">{item.label}</span>
                </li>
              ))}
            </ul>
            <div class={`mt-6 inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border ${d.tagColor} text-xs font-bold self-start`}>
              {d.total}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Grand total -->
    <div
      
      class="rounded-3xl p-10 md:p-14 text-center border border-gray-200 bg-white shadow-xl shadow-black/5"
    >
      <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mb-6">Complete system total</p>
      <div class="flex flex-wrap justify-center gap-10 md:gap-16 mb-8">
        <div>
          <p class="text-5xl md:text-6xl font-black text-e2-black" data-counter="1">0</p>
          <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mt-2">Pop-Up</p>
        </div>
        <div class="w-px bg-gray-200 hidden md:block"></div>
        <div>
          <p class="text-5xl md:text-6xl font-black text-e2-black" data-counter="24">0</p>
          <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mt-2">Emails</p>
        </div>
        <div class="w-px bg-gray-200 hidden md:block"></div>
        <div>
          <p class="text-5xl md:text-6xl font-black text-e2-black" data-counter="3">0</p>
          <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mt-2">SMS</p>
        </div>
        <div class="w-px bg-gray-200 hidden md:block"></div>
        <div>
          <p class="text-5xl md:text-6xl font-black" style="color: #6366f1;" data-counter="28">0</p>
          <p class="text-xs font-bold text-gray-400 uppercase tracking-widest mt-2">Total Touchpoints</p>
        </div>
      </div>
      <p class="text-gray-500 text-sm max-w-lg mx-auto leading-relaxed">
        All custom-designed. All yours. Live in 21 days.
      </p>
    </div>

  </div>
</section>
