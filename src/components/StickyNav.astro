---
/**
 * Sticky Nav , "Glass Pill"
 * Per 2026 playbook: sticky CTA bar following scroll, cold-traffic temperature copy
 * CTA links to dedicated Formflow application page.
 */
import { APPLY_URL } from "../lib/apply-url";
import StrategyCallStatus from "./StrategyCallStatus.astro";

interface Props {
  ctaLabel?: string;
}

const { ctaLabel = "See If You Qualify →" } = Astro.props;
---

<div
  id="sticky-nav"
  class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 transition-all duration-500 opacity-0 translate-y-10 w-[calc(100%-2rem)] sm:w-auto"
>
  <div
    class="glass pl-3 sm:pl-6 pr-2 py-2 rounded-full flex items-center gap-3 sm:gap-5 shadow-2xl shadow-black/15 border border-white/60"
  >
    <!-- e2 Logo — always visible, brand anchoring -->
    <div class="flex items-center gap-1.5 flex-shrink-0">
      <svg width="22" height="22" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect width="32" height="32" rx="8" fill="#050505"/>
        <text x="6" y="23" font-family="DM Sans, -apple-system, sans-serif" font-weight="900" font-size="18" fill="white">e2</text>
      </svg>
      <span class="text-xs font-black text-gray-900 tracking-tight hidden xs:inline sm:hidden">e2</span>
    </div>

    <!-- Divider -->
    <div class="w-px h-4 bg-gray-200 flex-shrink-0"></div>

    <!-- Social proof — condensed on mobile, full on sm+ -->
    <div class="flex items-center gap-2 min-w-0 flex-1">
      <span class="relative flex h-2 w-2 flex-shrink-0">
        <span
          class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-500 opacity-75"
          style="will-change: transform;"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"
        ></span>
      </span>
      <StrategyCallStatus
        surface="sticky"
        class="text-xs font-semibold text-gray-700 min-w-0 truncate"
      />
    </div>

    <!-- Separator — only on sm+ -->
    <div class="hidden sm:block w-px h-4 bg-gray-200 flex-shrink-0"></div>

    <!-- CTA — always full, 44px tap target -->
    <a
      href={APPLY_URL}
      data-apply-cta="sticky-nav"
      class="flex-shrink-0 px-5 sm:px-6 py-2.5 bg-e2-black text-white text-sm font-bold rounded-full hover:bg-gray-900 transition-colors duration-200 whitespace-nowrap cursor-pointer"
      style="min-height: 44px; display: flex; align-items: center;"
    >
      {ctaLabel}
    </a>
  </div>
</div>


<script>
  const nav = document.getElementById("sticky-nav");
  const qualify = document.getElementById("qualify");

  if (nav) {
    let qualifyVisible = false;

    if (qualify) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          qualifyVisible = entry.isIntersecting;
          if (qualifyVisible) {
            nav.classList.add("opacity-0", "translate-y-10");
          } else if (window.scrollY > 500) {
            nav.classList.remove("opacity-0", "translate-y-10");
          }
        },
        { threshold: 0.05 }
      );
      observer.observe(qualify);
    }

    window.addEventListener(
      "scroll",
      () => {
        if (qualifyVisible) return;
        if (window.scrollY > 500) {
          nav.classList.remove("opacity-0", "translate-y-10");
        } else {
          nav.classList.add("opacity-0", "translate-y-10");
        }
      },
      { passive: true }
    );
  }
</script>
