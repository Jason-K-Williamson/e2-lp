---
// Deferred PostHog loader — production + workwith.e2.agency only.
import {
  POSTHOG_ENABLED,
  POSTHOG_HOST,
  POSTHOG_KEY,
  POSTHOG_TRACKING_HOST,
} from "../lib/posthog-config";
---
{
  POSTHOG_ENABLED && (
    <script
      is:inline
      define:vars={{
        posthogKey: POSTHOG_KEY,
        posthogHost: POSTHOG_HOST,
        trackingHost: POSTHOG_TRACKING_HOST,
      }}
    >
      (function () {
        if (location.hostname !== trackingHost) return;

        window.posthog = window.posthog || [];
        var _ph = window.posthog;
        if (_ph.__SV) return;
        _ph._i = [];
        _ph.__SV = 1;
        _ph.init = function (i, s, a) {
          function g(t, e) {
            var o = e.split(".");
            if (o.length === 2) {
              t = t[o[0]];
              e = o[1];
            }
            t[e] = function () {
              t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
            };
          }
          var u = _ph;
          if (void 0 !== a) {
            u = _ph[a] = [];
          } else {
            a = "posthog";
          }
          u.people = u.people || [];
          u.toString = function (t) {
            var e = "posthog";
            if (a !== "posthog") e += "." + a;
            if (!t) e += " (stub)";
            return e;
          };
          u.people.toString = function () {
            return u.toString(1) + ".people (stub)";
          };
          "init capture register register_once register_for_session unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group identify setPersonProperties setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags resetGroups onFeatureFlags addFeatureFlagsHandler onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep"
            .split(" ")
            .forEach(function (m) {
              g(u, m);
            });
          _ph._i.push([i, s, a]);
        };

        window.addEventListener(
          "load",
          function () {
            function inject() {
              var s = document.createElement("script");
              s.async = true;
              s.src = "https://us-assets.i.posthog.com/static/array.js";
              document.head.appendChild(s);
              s.onload = function () {
                if (window.posthog && window.posthog.init) {
                  window.posthog.init(posthogKey, {
                    api_host: posthogHost,
                    ui_host: "https://us.posthog.com",
                    defaults: "2026-01-30",
                    // Manual $pageview in loaded() — SDK defaults also capture pageviews.
                    capture_pageview: false,
                    // Lazy session replay — started via startSessionRecording() in loaded().
                    disable_session_recording: true,
                    disable_surveys: true,
                    autocapture: true,
                    persistence: "localStorage+cookie",
                    cross_subdomain_cookie: true,
                    loaded: function (ph) {
                      try {
                        var url = new URL(window.location.href);
                        var fbclid = url.searchParams.get("fbclid");
                        var gclid = url.searchParams.get("gclid");
                        var ttclid = url.searchParams.get("ttclid");
                        var liclid = url.searchParams.get("li_fat_id");
                        var msclkid = url.searchParams.get("msclkid");
                        var sp = {};
                        if (fbclid) {
                          sp.fbc = "fb.1." + Date.now() + "." + fbclid;
                          sp.fbclid = fbclid;
                        }
                        if (gclid) sp.gclid = gclid;
                        if (ttclid) sp.ttclid = ttclid;
                        if (liclid) sp.li_fat_id = liclid;
                        if (msclkid) sp.msclkid = msclkid;
                        var fbpMatch = document.cookie.match(
                          /(?:^|; )_fbp=([^;]+)/
                        );
                        if (fbpMatch) sp.fbp = fbpMatch[1];
                        if (Object.keys(sp).length) {
                          ph.register_once(sp);
                          ph.setPersonProperties(undefined, sp);
                        }
                      } catch (e) {}

                      var pageVariant =
                        document.body &&
                        document.body.getAttribute("data-page-variant");
                      if (pageVariant) {
                        ph.register({ page_variant: pageVariant });
                      }

                      ph.capture("$pageview");

                      // Session replay: init with disable_session_recording so
                      // rrweb bundle stays off the critical path. Start lazily
                      // after idle once pageview + attribution are captured.
                      function startRecording() {
                        if (ph.startSessionRecording) ph.startSessionRecording();
                      }
                      if ("requestIdleCallback" in window) {
                        requestIdleCallback(startRecording, { timeout: 15000 });
                      } else {
                        setTimeout(startRecording, 5000);
                      }
                    },
                  });
                }
              };
            }
            setTimeout(function () {
              if ("requestIdleCallback" in window) {
                requestIdleCallback(inject, { timeout: 10000 });
              } else {
                setTimeout(inject, 1000);
              }
            }, 3000);
          },
          { once: true }
        );
      })();
    </script>
  )
}
