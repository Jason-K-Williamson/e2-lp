---
/**
 * FounderNote — light founder section above dark case studies.
 *
 * Headshot: transparent PNG exported from Figma (src/assets/images/jason-k-williamson.png).
 *
 * COPY RULE (matches src/lib/home-copy.ts): no em/en dashes in visible copy.
 */
import { Image } from "astro:assets";
import { APPLY_URL } from "../lib/apply-url";
import imgJason from "../assets/images/jason-k-williamson.png";
import imgVoid from "../assets/brand-logos/void.webp";

const marqueeItems = [
  "Jason K Williamson",
  "$25M+ SMS for The Oodie",
  "Head Coach at Daily Mentor",
  "13 Years in Email & SMS",
  "$225M+ Generated",
  "2,000+ Brands",
];
---

<section
  class="fdr relative w-full overflow-hidden bg-white"
  aria-labelledby="founder-heading"
>
  <!-- Marquee ribbon -->
  <div
    class="relative border-y border-slate-200/80 py-3 overflow-hidden select-none bg-slate-50/60"
    aria-hidden="true"
  >
    <div class="fdr-marquee flex w-max items-center gap-0 whitespace-nowrap">
      {
        [0, 1].map(() => (
          <div class="flex items-center">
            {marqueeItems.map((item) => (
              <span class="flex items-center text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.28em] text-slate-400">
                <span class="px-5 sm:px-7">{item}</span>
                <span class="text-blue-500/60">&#9670;</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- Atmosphere -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div
      class="fdr-glow absolute right-[-8%] bottom-[-10%] w-[560px] h-[560px] rounded-full"
      style="background: radial-gradient(circle, rgba(59,130,246,0.12) 0%, rgba(99,102,241,0.06) 45%, transparent 70%);"
    >
    </div>
    <div
      class="absolute left-[-12%] top-[10%] w-[420px] h-[420px] rounded-full"
      style="background: radial-gradient(circle, rgba(99,102,241,0.08) 0%, transparent 65%);"
    >
    </div>
    <div
      class="absolute inset-0 opacity-[0.35]"
      style="background-image: linear-gradient(rgba(15,23,42,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(15,23,42,0.04) 1px, transparent 1px); background-size: 72px 72px;"
    >
    </div>
  </div>

  <div
    class="section-container relative z-10 pt-14 sm:pt-18 lg:pt-20 pb-0 lg:grid lg:grid-cols-12 lg:gap-8 xl:gap-12 lg:items-end"
  >
    <!-- Left: copy -->
    <div class="lg:col-span-7 pb-12 sm:pb-14 lg:pb-20">
      <div class="inline-flex items-center gap-2 mb-5" data-animate>
        <span class="h-px w-8 bg-gradient-to-r from-blue-600 to-transparent"
        ></span>
        <span
          class="text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.3em] text-blue-600"
          >About the Founder</span
        >
      </div>

      <h2
        id="founder-heading"
        class="font-black text-slate-900 tracking-tight leading-[1.08] text-[clamp(1.75rem,4.2vw,3.25rem)] text-balance mb-5"
        data-animate
        style="transition-delay: 0.08s"
      >
        Meet Jason K Williamson <span class="text-slate-300 font-light">|</span> Founder of e2 Agency
      </h2>

      <p
        class="text-sm sm:text-base text-slate-600 leading-relaxed max-w-xl mb-8"
        data-animate
        style="transition-delay: 0.16s"
      >
        Serial entrepreneur and CEO of e2 Agency. Jason spent 2+ years as head
        Email &amp; SMS coach at
        <strong class="text-slate-900 font-semibold">Daily Mentor</strong>,
        built the SMS engine behind
        <strong class="text-slate-900 font-semibold">The Oodie's $25M+</strong>,
        and has been in email &amp; SMS for 13 years. He helps 6-8 figure Shopify
        brands unlock an extra 30-40% from retention. When you book a call, you
        talk to Jason directly. No juniors. No handoffs.
      </p>

      <dl
        class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-8"
        data-animate
        style="transition-delay: 0.24s"
      >
        {
          [
            { value: "$25M+", label: "Oodie SMS" },
            { value: "13 yrs", label: "Email & SMS" },
            { value: "$225M+", label: "Generated" },
            { value: "2,000+", label: "Brands" },
          ].map((stat) => (
            <div class="rounded-xl border border-slate-200/90 bg-white shadow-sm shadow-slate-900/[0.03] px-3 py-4 sm:py-5 text-center">
              <dt class="sr-only">{stat.label}</dt>
              <dd
                class="text-xl sm:text-2xl font-black text-slate-900 tabular-nums tracking-tight"
                data-counter={stat.value}
              >
                {stat.value}
              </dd>
              <dd class="text-[9px] sm:text-[10px] text-slate-400 uppercase font-bold tracking-[0.14em] leading-tight mt-1">
                {stat.label}
              </dd>
            </div>
          ))
        }
      </dl>

      <figure
        class="relative rounded-2xl border border-slate-200/90 bg-slate-50/80 px-5 py-4 sm:px-6 sm:py-5 mb-8 max-w-xl"
        data-animate
        style="transition-delay: 0.32s"
      >
        <span
          class="absolute -top-3 left-5 text-blue-600/30 text-4xl font-black leading-none select-none"
          aria-hidden="true">&ldquo;</span
        >
        <blockquote class="text-[13px] sm:text-sm text-slate-600 leading-relaxed">
          His name's Jason. He's a super good dude and his team is amazing.
          They do the artwork, subject lines, campaigns, flows, copywriting,
          absolutely everything. I haven't done a thing when it comes to
          emails.
        </blockquote>
        <figcaption
          class="mt-3 flex items-center gap-2.5 text-[11px] sm:text-xs font-semibold text-slate-500"
        >
          <Image
            src={imgVoid}
            alt="VOID"
            widths={[80, 120, 160]}
            sizes="56px"
            quality={70}
            loading="lazy"
            decoding="async"
            class="h-3.5 w-auto invert opacity-70"
          />
          <span>Jordan Bown, Founder, VOID</span>
        </figcaption>
      </figure>

      <div data-animate style="transition-delay: 0.4s">
        <a
          href={APPLY_URL}
          data-apply-cta="founder-note"
          class="group inline-flex items-center justify-center gap-2 px-7 sm:px-8 py-3.5 min-h-[52px] bg-e2-black text-white rounded-full font-bold text-sm sm:text-base hover:bg-gray-900 transition-all duration-300 shadow-xl shadow-black/10 hover:shadow-2xl hover:shadow-black/15"
        >
          Book a Strategy Call with Jason Himself
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 20 20"
            fill="currentColor"
            class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
            aria-hidden="true"
          >
            <path
              fill-rule="evenodd"
              d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
      </div>
    </div>

    <!-- Right: headshot (black cutout on white) -->
    <div
      class="fdr-photo relative lg:col-span-5 flex justify-center lg:justify-end items-end min-h-[320px] sm:min-h-[380px] lg:min-h-0"
      data-animate
      style="transition-delay: 0.2s"
    >
      <div
        class="absolute left-[8%] sm:left-[14%] lg:left-0 top-[8%] sm:top-[12%] w-[84px] h-[84px] sm:w-[100px] sm:h-[100px] z-20 pointer-events-none"
        aria-hidden="true"
      >
        <svg
          viewBox="0 0 100 100"
          class="fdr-spin w-full h-full drop-shadow-md"
        >
          <defs>
            <path
              id="fdr-circle-path"
              d="M 50,50 m -37,0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0"
            ></path>
          </defs>
          <circle cx="50" cy="50" r="48" fill="white" stroke="rgba(226,232,240,0.9)" stroke-width="1"></circle>
          <text
            class="fill-blue-600/80"
            style="font-size: 10.5px; font-weight: 800; letter-spacing: 0.2em; text-transform: uppercase;"
          >
            <textPath href="#fdr-circle-path">
              13 yrs Email &amp; SMS &#9670; Founder &#9670;
            </textPath>
          </text>
        </svg>
        <div
          class="absolute inset-0 flex items-center justify-center text-base sm:text-lg font-black text-slate-900"
        >
          e&#178;
        </div>
      </div>

      <Image
        src={imgJason}
        alt="Jason K Williamson, founder of e2 Agency"
        widths={[388, 580, 776]}
        sizes="(max-width: 640px) 320px, (max-width: 1024px) 380px, 440px"
        quality={75}
        loading="lazy"
        decoding="async"
        class="relative z-10 w-[280px] sm:w-[340px] lg:w-[420px] xl:w-[460px] h-auto select-none"
      />

      <div
        class="absolute bottom-4 sm:bottom-6 left-1/2 -translate-x-1/2 lg:left-auto lg:right-4 lg:translate-x-0 z-20 rounded-xl border border-slate-200/90 bg-white/95 backdrop-blur-sm shadow-lg shadow-slate-900/5 px-4 py-2.5 text-center lg:text-left whitespace-nowrap"
      >
        <div class="text-sm sm:text-base font-bold text-slate-900 leading-tight">
          Jason K Williamson
        </div>
        <div
          class="text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.18em] text-blue-600 mt-0.5"
        >
          Founder, e2 Agency
        </div>
      </div>
    </div>
  </div>

  <!-- Hard seam into the dark case-study section below -->
  <div
    class="h-px w-full bg-gradient-to-r from-transparent via-slate-200 to-transparent"
    aria-hidden="true"
  ></div>
</section>

<style>
  .fdr-marquee {
    animation: fdr-marquee 36s linear infinite;
  }
  @keyframes fdr-marquee {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  .fdr-glow {
    animation: fdr-breathe 7s ease-in-out infinite;
  }
  @keyframes fdr-breathe {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.9;
    }
    50% {
      transform: scale(1.1);
      opacity: 1;
    }
  }

  .fdr-spin {
    animation: fdr-spin 22s linear infinite;
  }
  @keyframes fdr-spin {
    to {
      transform: rotate(360deg);
    }
  }

  .fdr-photo[data-animate] {
    transform: translate3d(0, 36px, 0) scale(0.98);
    transition-duration: 0.9s;
  }
  .fdr-photo[data-animate].is-visible {
    transform: translate3d(0, 0, 0) scale(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .fdr-marquee,
    .fdr-glow,
    .fdr-spin {
      animation: none;
    }
    .fdr-photo[data-animate] {
      transform: none;
      transition: none;
    }
  }
</style>
