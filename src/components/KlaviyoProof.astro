---
/**
 * KlaviyoProof.astro
 * Live dashboard screenshots, compact carousel (no full-viewport height).
 * Nav sits between headline and image so it’s never hidden behind the sticky CTA bar.
 *
 * Image stage height: tallest carousel asset is 23-million.avif (966×1024).
 * At max stage width (~768px) that’s ~814px tall; stage is fixed at 300px so the
 * section stays scannable while every slide uses the same viewport (no nav jump).
 */

type Shot = {
  src: string;
  caption: string;
  title: string;
  description: string;
};

const tabs: { id: string; label: string; count: number; shots: Shot[] }[] = [
  {
    id: "revenue",
    label: "Revenue Wins",
    count: 9,
    shots: [
      {
        src: "/klaviyo-proof/23-million.avif",
        caption: "$23M attributed",
        title: "$23 million for The Oodie",
        description:
          "We helped drive $23M+ in attributed revenue, verified numbers straight from their Klaviyo dashboard, not a mockup.",
      },
      {
        src: "/klaviyo-proof/22.8-million.avif",
        caption: "$22.8M attributed",
        title: "$22.8M in attributed revenue",
        description:
          "Another eight-figure attributed revenue result, lifecycle and flows doing the heavy lifting behind the scenes.",
      },
      {
        src: "/klaviyo-proof/4.5-million-via-a-welcome-series.avif",
        caption: "$4.5M via welcome series",
        title: "$4.5M from a welcome series",
        description:
          "First-party email doing real work: onboarding and welcome automation attributed millions over the tracking window.",
      },
      {
        src: "/klaviyo-proof/2.3m-postscript.avif",
        caption: "$2.3M via Postscript SMS",
        title: "$2.3M with SMS (Postscript)",
        description:
          "We made $2.3M for this brand with SMS marketing using Postscript, shown here alongside their email attribution.",
      },
      {
        src: "/klaviyo-proof/abandoned-cart-700k.avif",
        caption: "$700k, abandoned cart flow",
        title: "$700k+ from abandoned cart",
        description:
          "Recovery flows that pay rent: cart and browse abandonment attributed serious revenue in-channel.",
      },
      {
        src: "/klaviyo-proof/210k-in-one-email.jpeg",
        caption: "$210k in one email",
        title: "$210k from a single send",
        description:
          "One campaign, one slice of the dashboard, when creative, offer, and list health line up, the spike is real.",
      },
      {
        src: "/klaviyo-proof/adam-said-we-broke-a-record.avif",
        caption: "We broke a record",
        title: "Record-breaking day",
        description:
          "Client-verified: their team called out a new record, we screenshot the moment from the live account.",
      },
      {
        src: "/klaviyo-proof/nexus-supplements-proof-biggest-day-on-record.avif",
        caption: "Nexus, biggest day on record",
        title: "Nexus, biggest day on record",
        description:
          "Supplements brand; Klaviyo showed their largest revenue day, attribution you can point to in a sales call.",
      },
      {
        src: "/klaviyo-proof/alesandro-testimonial.avif",
        caption: "Alessandro, verified result",
        title: "Verified client shout-out",
        description:
          "Named proof from a founder, paired with dashboard context so it’s not just a quote on a slide.",
      },
    ],
  },
  {
    id: "attribution",
    label: "% Attribution",
    count: 22,
    shots: [
      { src: "/klaviyo-proof/58pct.avif", caption: "58% of total revenue", title: "58% of store revenue", description: "Klaviyo attributed more than half of revenue, direct from the account’s attribution view." },
      { src: "/klaviyo-proof/54-9pct.avif", caption: "54.9% attribution", title: "54.9% attribution", description: "Email and SMS carrying the majority of tracked revenue for this brand." },
      { src: "/klaviyo-proof/53-percent.avif", caption: "53% attribution", title: "53% of revenue attributed", description: "Strong channel mix: owned channels doing the lion’s share of reported revenue." },
      { src: "/klaviyo-proof/50-percent.avif", caption: "50% attribution", title: "Half of revenue from Klaviyo", description: "A clean 50/50 story in the dashboard, powerful for stakeholder updates." },
      { src: "/klaviyo-proof/another-50pct.avif", caption: "Another 50% result", title: "Another 50% attribution win", description: "We see this pattern repeatedly when flows and campaigns are dialed in." },
      { src: "/klaviyo-proof/from-35pct-to-50pct.avif", caption: "35% to 50%", title: "35% → 50% attribution", description: "Before/after energy: moving owned-channel share up materially over time." },
      { src: "/klaviyo-proof/48-5pct.avif", caption: "48.5% attribution", title: "48.5% attributed revenue", description: "Nearly half of revenue tied back to Klaviyo-tracked touches." },
      { src: "/klaviyo-proof/44-2pct.avif", caption: "44.2% attribution", title: "44.2% attribution", description: "Mid-forties attribution, consistent performance across the reporting period." },
      { src: "/klaviyo-proof/44-percent.avif", caption: "44% attribution", title: "44% of total revenue", description: "Owned channels pulling strong weight in the brand’s revenue mix." },
      { src: "/klaviyo-proof/43.4-percent.avif", caption: "43.4% attribution", title: "43.4% attribution", description: "Screenshot-proof share of revenue from Klaviyo-attributed orders." },
      { src: "/klaviyo-proof/43-percent-before-and-after.webp", caption: "43% before and after", title: "43%, before & after", description: "A narrative-friendly grab: movement in attribution over a defined window." },
      { src: "/klaviyo-proof/43-percent.avif", caption: "43% attribution", title: "43% attributed", description: "Solid two-fifths-plus of revenue credited to lifecycle marketing." },
      { src: "/klaviyo-proof/43pct.avif", caption: "43% attribution", title: "43% share of revenue", description: "Another account showing Klaviyo as a primary growth lever." },
      { src: "/klaviyo-proof/41-percent.webp", caption: "41% attribution", title: "41% attribution", description: "High thirties / low forties is a recurring band for well-run programs." },
      { src: "/klaviyo-proof/37-percent.avif", caption: "37% attribution", title: "37% of revenue", description: "More than a third of revenue attributed, meaningful for any DTC P&L." },
      { src: "/klaviyo-proof/36pct.avif", caption: "36% attribution", title: "36% attribution", description: "Healthy owned-channel contribution with room still to scale." },
      { src: "/klaviyo-proof/33-percent.avif", caption: "33% attribution", title: "33% attributed revenue", description: "A third of revenue from Klaviyo-tracked activity, credible and defensible." },
      { src: "/klaviyo-proof/32-percent.avif", caption: "32% attribution", title: "32% of store revenue", description: "Repeatable playbook: campaigns + flows + segmentation." },
      { src: "/klaviyo-proof/31pct.avif", caption: "31% attribution", title: "31% attribution", description: "Demonstrates traction even when the brand has other large channels." },
      { src: "/klaviyo-proof/31.avif", caption: "31% attribution", title: "31% share", description: "Snapshot from a live dashboard, not a deck graphic." },
      { src: "/klaviyo-proof/20-percent.avif", caption: "20% attribution", title: "20% attributed revenue", description: "Every account starts somewhere, this is still real money back to owned channels." },
      { src: "/klaviyo-proof/little-label-co-from-2.2-to-7-percent-optin-rate-pop-up.avif", caption: "Little Label Co, 2.2% to 7% opt-in", title: "Little Label Co, 2.2% → 7% opt-in", description: "Pop-up optimization showing up in the numbers, better list growth, better downstream revenue." },
    ],
  },
  {
    id: "brands",
    label: "Named Brands",
    count: 7,
    shots: [
      { src: "/klaviyo-proof/bogey-bros-proof.avif", caption: "Bogey Bros", title: "Bogey Bros", description: "Named brand, real account, dashboard proof we can share on calls and in proposals." },
      { src: "/klaviyo-proof/daily-mentor-proof.webp", caption: "The Daily Mentor", title: "The Daily Mentor", description: "Creator-led brand; Klaviyo metrics shown with the brand context intact." },
      { src: "/klaviyo-proof/platinum-master-proof.avif", caption: "Platinum Master", title: "Platinum Master", description: "Another named win, not anonymous “Brand A” slides." },
      { src: "/klaviyo-proof/26-percent-twosvge.webp", caption: "TWOSVGE, 26%", title: "TWOSVGE, 26% attribution", description: "Public-facing name plus a concrete attribution figure from the stack." },
      { src: "/klaviyo-proof/30-percent-tyler-from-bap.avif", caption: "Tyler, BAP, 30%", title: "Tyler @ BAP, 30%", description: "Founder-attributed screenshot, credibility for skeptical buyers." },
      { src: "/klaviyo-proof/nexus-supplements-proof-biggest-day-on-record.avif", caption: "Nexus Supplements", title: "Nexus Supplements", description: "Supplements vertical; biggest-day-on-record callout from their metrics." },
      { src: "/klaviyo-proof/little-label-co-from-2.2-to-7-percent-optin-rate-pop-up.avif", caption: "Little Label Co", title: "Little Label Co", description: "Opt-in rate lift story, from pop-up through to list and revenue impact." },
    ],
