];
---

<section
  class="relative scroll-mt-4 overflow-hidden bg-[#050505] py-16 pb-28 md:py-24 md:pb-32"
  id="klaviyo-proof"
  aria-labelledby="kp-heading"
  style="--kp-stage-h: 300px"
>
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-gray-950 via-[#08090c] to-gray-950"
  >
  </div>
  <!-- Centered ambient glow (was left-1/4, felt visually off-axis) -->
  <div
    class="pointer-events-none absolute top-0 left-1/2 h-[min(520px,80vw)] w-[min(520px,80vw)] -translate-x-1/2 rounded-full bg-blue-600/[0.09] blur-[120px]"
  >
  </div>
  <div
    class="pointer-events-none absolute bottom-0 left-1/2 h-[min(420px,70vw)] w-[min(420px,70vw)] -translate-x-1/2 translate-y-1/2 rounded-full bg-indigo-600/[0.08] blur-[100px]"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.35] [background-image:radial-gradient(rgba(255,255,255,0.04)_1px,transparent_1px)] [background-size:24px_24px]"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 mx-auto w-full max-w-5xl px-4 sm:px-6 lg:px-8">

    <div class="mx-auto mb-10 max-w-2xl text-center md:mb-12">
      <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-blue-400/95">Live Klaviyo Dashboards</p>
      <h2 id="kp-heading" class="mb-4 text-balance text-3xl font-bold leading-[1.12] tracking-tight text-white sm:text-4xl md:text-[2.75rem]">
        Real Numbers.<br />
        <span class="text-gray-300">Real Accounts. No Photoshop.</span>
      </h2>
      <p class="text-pretty text-sm leading-relaxed text-gray-300 sm:text-base md:text-lg">
        <strong class="font-semibold text-gray-300">40+ verified screenshots</strong> from live client accounts, not mockups, not a deck. Click through every proof.
      </p>
    </div>

    <div class="mb-8 flex flex-wrap justify-center gap-2 md:mb-10" role="tablist" aria-label="Proof categories">
      {tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          data-kp-tab={tab.id}
          aria-selected={i === 0 ? "true" : "false"}
          class={`kp-tab min-h-11 px-4 sm:px-5 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-bold border transition-all duration-200 cursor-pointer inline-flex items-center justify-center ${
            i === 0
              ? "bg-white text-gray-900 border-white"
              : "bg-transparent text-gray-500 border-gray-700 hover:border-gray-400 hover:text-white"
          }`}
        >
          {tab.label}
          <span class="ml-1.5 text-[10px] sm:text-xs opacity-50">{tab.count}</span>
        </button>
      ))}
    </div>

    {tabs.map((tab, i) => (
      <div
        id={`kp-carousel-${tab.id}`}
        data-kp-panel={tab.id}
        data-kp-total={tab.shots.length}
        class={`kp-carousel mx-auto grid w-full max-w-4xl grid-cols-1 select-none overflow-hidden rounded-2xl border border-white/10 bg-white/[0.03] shadow-[0_32px_120px_rgba(0,0,0,0.45)] ring-1 ring-white/[0.06] backdrop-blur-md sm:rounded-[2rem] md:rounded-[2.5rem] ${i !== 0 ? "hidden" : ""}`}
      >
        <div class="hidden kp-shot-store" aria-hidden="true">
          {tab.shots.map((shot) => (
            <span
              data-src={shot.src}
              data-caption={shot.caption}
              data-title={shot.title}
              data-desc={shot.description}
            />
          ))}
        </div>

        <div class="kp-carousel-body flex w-full min-h-0 flex-col items-center px-4 py-6 sm:px-8 sm:py-8 lg:px-10 lg:py-10">
          <!-- Copy: fixed min-height so title/desc swaps never push arrows -->
          <div class="kp-copy-block mb-6 flex w-full max-w-2xl flex-col justify-center text-center sm:mb-8">
            <p class="mb-2 text-[10px] font-bold uppercase tracking-[0.22em] text-blue-400/90 sm:mb-3 sm:text-xs">
              {tab.shots.length} proofs in this category
            </p>
            <h3 class="kp-win-title mb-3 min-h-[3.25rem] text-balance text-2xl font-bold leading-snug tracking-tight text-white sm:mb-4 sm:min-h-[3.75rem] sm:text-3xl md:min-h-[4.25rem] md:text-4xl">
              {tab.shots[0]!.title}
            </h3>
            <p class="kp-win-desc mx-auto min-h-[4.75rem] max-w-xl text-pretty text-sm leading-relaxed text-gray-300 sm:min-h-[5.25rem] sm:text-base">
              {tab.shots[0]!.description}
            </p>
          </div>

          <!-- Screenshot row: same fixed stage on every tab + every slide -->
          <div class="flex w-full max-w-3xl flex-col items-stretch gap-4 sm:gap-5">
            <div class="kp-image-row flex w-full shrink-0 items-center justify-center gap-2 sm:gap-3 md:gap-4">
              <button
                type="button"
                class="kp-prev flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/15 bg-gray-900/90 text-white shadow-[0_4px_20px_rgba(0,0,0,0.5)] backdrop-blur-md transition-all duration-200 hover:scale-[1.03] hover:bg-gray-800 disabled:pointer-events-none disabled:opacity-0 md:h-12 md:w-12"
                aria-label="Previous proof"
              >
                <svg class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
              </button>

              <div
                role="button"
                tabindex="0"
                class="kp-zoom-trigger group relative z-10 flex h-full min-h-0 min-w-0 flex-1 cursor-zoom-in items-center justify-center overflow-hidden rounded-xl bg-white shadow-[0_24px_80px_rgba(0,0,0,0.6)] ring-1 ring-white/10 transition-transform duration-300 hover:-translate-y-0.5 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0c0d12] sm:rounded-2xl"
                aria-label={`View fullscreen: ${tab.shots[0]!.caption}`}
              >
                <img
                  src={tab.shots[0]!.src}
                  alt={tab.shots[0]!.caption}
                  width={966}
                  height={1024}
                  loading={i === 0 ? "eager" : "lazy"}
                  decoding="async"
                  class="kp-main-img max-h-full max-w-full object-contain object-center"
                />
              </div>

              <button
                type="button"
                class="kp-next flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/15 bg-gray-900/90 text-white shadow-[0_4px_20px_rgba(0,0,0,0.5)] backdrop-blur-md transition-all duration-200 hover:scale-[1.03] hover:bg-gray-800 disabled:pointer-events-none disabled:opacity-0 md:h-12 md:w-12"
                aria-label="Next proof"
              >
                <svg class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </div>

            <!-- Footer: fixed min-height so dot count differences between tabs don't shift layout -->
            <div class="kp-carousel-footer flex w-full shrink-0 flex-col items-center justify-end gap-3">
              <div
                class="kp-dots-row flex max-w-full justify-center gap-1.5 overflow-x-auto pb-1 [scrollbar-width:thin]"
                role="group"
                aria-label="Slide indicators"
              >
                {tab.shots.map((_, di) => (
                  <button
                    type="button"
                    class="kp-dot flex h-11 w-11 shrink-0 cursor-pointer items-center justify-center rounded-full border-0 bg-transparent p-0"
                    data-dot-index={di}
                    aria-label={`Go to slide ${di + 1} of ${tab.shots.length}`}
                  >
                    <span
                      class={`kp-dot-inner block h-1.5 rounded-full transition-all duration-200 ${di === 0 ? "w-6 bg-white" : "w-1.5 bg-white/25 hover:bg-white/45"}`}
                      aria-hidden="true"
                    />
                  </button>
                ))}
              </div>
              <div class="flex flex-col items-center gap-1.5 text-center sm:flex-row sm:gap-3">
                <span class="font-mono text-xs tabular-nums text-gray-400">
                  <span class="kp-counter font-semibold text-white">1</span>
                  <span class="mx-1 text-gray-600">/</span>
                  <span>{tab.shots.length}</span>
                </span>
                <span class="text-[11px] text-gray-400">Arrows, dots, or swipe</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    ))}

  </div>
</section>

<div
  id="kp-fullscreen"
  class="fixed inset-0 z-[9999] hidden bg-black cursor-pointer"
  role="dialog"
  aria-modal="true"
  aria-label="Fullscreen screenshot"
>
  <button
    type="button"
    id="kp-fs-close"
    class="absolute top-5 right-5 z-10 min-h-11 min-w-11 rounded-full bg-white/10 hover:bg-white/25 flex items-center justify-center text-white transition-colors cursor-pointer"
    aria-label="Close fullscreen"
  >
    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
    </svg>
  </button>

  <p id="kp-fs-caption" class="absolute top-5 left-5 z-10 text-white/50 text-xs font-bold uppercase tracking-widest max-w-[70%]"></p>

  <div class="w-full h-full flex items-center justify-center p-4 md:p-10" id="kp-fs-inner">
    <img
      id="kp-fs-img"
      src=""
      alt=""
      width="960"
      height="600"
      class="max-w-full max-h-full object-contain rounded-xl"
      style="cursor: default;"
    />
  </div>

  <p class="absolute bottom-5 left-0 right-0 text-center text-white/25 text-xs tracking-widest">ESC or click outside to close</p>
</div>

<style is:global>
  /*
   * Klaviyo proof carousels — one locked layout for Revenue, % Attribution, and Named Brands.
   * Tallest screenshot: 23-million.avif (966×1024) → 300px stage at max width.
   * Copy + footer min-heights stop slide/tab text swaps from moving the arrow row.
   */
  #klaviyo-proof {
    --kp-stage-h: 300px;
  }
  @media (max-width: 639px) {
    #klaviyo-proof {
      --kp-stage-h: min(45vh, 300px);
    }
  }

  #klaviyo-proof .kp-copy-block {
    min-height: 12.75rem;
  }
  @media (min-width: 640px) {
    #klaviyo-proof .kp-copy-block {
      min-height: 14rem;
    }
  }
  @media (min-width: 768px) {
    #klaviyo-proof .kp-copy-block {
      min-height: 15.25rem;
    }
  }

  #klaviyo-proof .kp-image-row {
    height: var(--kp-stage-h);
    flex-shrink: 0;
  }

  #klaviyo-proof .kp-carousel-footer {
    min-height: 5.5rem;
    flex-shrink: 0;
  }

  #klaviyo-proof .kp-carousel .kp-main-img {
    width: auto;
    height: auto;
    max-height: 100%;
    max-width: 100%;
  }

  /* Attention pulse on the Next button so first-time viewers see it's clickable.
     Expanding ring + gentle bob; removed on first interaction (see script). */
  @keyframes kpNextPulse {
    0%, 100% {
      transform: scale(1);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), 0 0 0 0 rgba(96, 165, 250, 0.6);
    }
    50% {
      transform: scale(1.1);
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), 0 0 0 12px rgba(96, 165, 250, 0);
    }
  }
  .kp-next-flash {
    animation: kpNextPulse 1.35s ease-in-out infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .kp-next-flash {
      animation: none;
    }
  }
</style>

<script>
  type ShotMeta = { src: string; caption: string; title: string; desc: string };

  function readShots(container: HTMLElement): ShotMeta[] {
    return Array.from(container.querySelectorAll<HTMLElement>(".kp-shot-store > span")).map((el) => ({
      src: el.dataset.src ?? "",
      caption: el.dataset.caption ?? "",
      title: el.dataset.title ?? "",
      desc: el.dataset.desc ?? "",
    }));
  }

  function setupCarousel(container: HTMLElement) {
    const shots = readShots(container);
    if (!shots.length) return;

    const titleEl = container.querySelector<HTMLElement>(".kp-win-title")!;
    const descEl = container.querySelector<HTMLElement>(".kp-win-desc")!;
    const imgEl = container.querySelector<HTMLImageElement>(".kp-main-img")!;
    const zoomBtn = container.querySelector<HTMLButtonElement>(".kp-zoom-trigger")!;
    const prevBtn = container.querySelector<HTMLButtonElement>(".kp-prev")!;
    const nextBtn = container.querySelector<HTMLButtonElement>(".kp-next")!;
    const counter = container.querySelector<HTMLElement>(".kp-counter")!;
    const dots = Array.from(container.querySelectorAll<HTMLButtonElement>(".kp-dot"));
    const total = shots.length;
    let current = 0;

    function apply(i: number, scrollDotIntoView = true) {
      current = Math.max(0, Math.min(i, total - 1));
      const s = shots[current]!;
      titleEl.textContent = s.title;
      descEl.textContent = s.desc;
      imgEl.src = s.src;
      imgEl.alt = s.caption;
      zoomBtn.setAttribute("aria-label", `View fullscreen: ${s.caption}`);

      counter.textContent = String(current + 1);

      prevBtn.toggleAttribute("disabled", current === 0);
      nextBtn.toggleAttribute("disabled", current === total - 1);

      dots.forEach((dot, di) => {
        const inner = dot.querySelector<HTMLElement>(".kp-dot-inner");
        if (!inner) return;
        const active = di === current;
        inner.classList.toggle("bg-white", active);
        inner.classList.toggle("w-6", active);
        inner.classList.toggle("bg-white/25", !active);
        inner.classList.toggle("hover:bg-white/45", !active);
        inner.classList.toggle("w-1.5", !active);
      });

      // scrollIntoView on load scrolls the whole page down to this section, only
      // run when the user actually changes slides (horizontal dot strip).
      if (scrollDotIntoView) {
        dots[current]?.scrollIntoView({ inline: "center", block: "nearest", behavior: "smooth" });
      }
    }

    function openFs() {
      const s = shots[current]!;
      openFullscreen(s.src, s.caption);
    }

    prevBtn.addEventListener("click", () => apply(current - 1));
    nextBtn.addEventListener("click", () => apply(current + 1));

    zoomBtn.addEventListener("click", openFs);
    zoomBtn.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        openFs();
      }
    });

    dots.forEach((dot, di) => {
      dot.addEventListener("click", () => apply(di));
    });

    let touchStartX = 0;
    let touchStartY = 0;
    let swiping = false;

    container.addEventListener(
      "touchstart",
      (e: TouchEvent) => {
        touchStartX = e.touches[0].clientX;
        touchStartY = e.touches[0].clientY;
        swiping = true;
      },
      { passive: true },
    );

    container.addEventListener(
      "touchend",
      (e: TouchEvent) => {
        if (!swiping) return;
        swiping = false;
        const dx = touchStartX - e.changedTouches[0].clientX;
        const dy = touchStartY - e.changedTouches[0].clientY;
        if (Math.abs(dx) > Math.abs(dy) && Math.abs(dx) > 48) {
          apply(dx > 0 ? current + 1 : current - 1);
        }
      },
      { passive: true },
    );

    container.tabIndex = 0;
    container.addEventListener("keydown", (e: KeyboardEvent) => {
      if (e.key === "ArrowLeft") {
        e.preventDefault();
        apply(current - 1);
      }
      if (e.key === "ArrowRight") {
        e.preventDefault();
        apply(current + 1);
      }
    });

    apply(0, false);
  }

  const fsOverlay = document.getElementById("kp-fullscreen") as HTMLElement;
  const fsImg = document.getElementById("kp-fs-img") as HTMLImageElement;
  const fsCaption = document.getElementById("kp-fs-caption") as HTMLElement;
  const fsClose = document.getElementById("kp-fs-close") as HTMLButtonElement;
  const fsInner = document.getElementById("kp-fs-inner") as HTMLElement;

  function openFullscreen(src: string, cap: string) {
    fsImg.src = src;
    fsImg.alt = cap;
    fsCaption.textContent = cap;
    fsOverlay.classList.remove("hidden");
    fsOverlay.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeFs() {
    fsOverlay.classList.add("hidden");
    fsOverlay.classList.remove("flex");
    document.body.style.overflow = "";
    fsImg.src = "";
  }

  fsOverlay.addEventListener("click", (e) => {
    if (!fsInner.contains(e.target as Node) || e.target === fsOverlay || e.target === fsInner) {
      closeFs();
    }
  });

  fsClose.addEventListener("click", closeFs);

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeFs();
  });

  const tabBtns = document.querySelectorAll<HTMLButtonElement>(".kp-tab");
  const panels = document.querySelectorAll<HTMLElement>(".kp-carousel");

  tabBtns.forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = btn.dataset.kpTab!;

      tabBtns.forEach((b) => {
        const active = b.dataset.kpTab === target;
        b.setAttribute("aria-selected", active ? "true" : "false");
        b.className = `kp-tab min-h-11 inline-flex items-center justify-center px-4 sm:px-5 py-2 sm:py-2.5 rounded-full text-xs sm:text-sm font-bold border transition-all duration-200 cursor-pointer ${
          active
            ? "bg-white text-gray-900 border-white"
            : "bg-transparent text-gray-500 border-gray-700 hover:border-gray-400 hover:text-white"
        }`;
      });

      panels.forEach((p) => {
        p.classList.toggle("hidden", p.dataset.kpPanel !== target);
      });
    });
  });

  document.querySelectorAll<HTMLElement>(".kp-carousel").forEach(setupCarousel);

  // ── Next-button attention flash ──────────────────────────────────────────
  // When the proof section scrolls into view, pulse the Next button(s) so
  // first-time viewers realise the carousel is clickable. Stop the moment the
  // user interacts with the section (click / tap / key / hover on a control).
  (function () {
    const kpSection = document.getElementById("klaviyo-proof");
    if (!kpSection) return;
    const nextBtns = Array.from(
      kpSection.querySelectorAll<HTMLButtonElement>(".kp-next"),
    );
    if (!nextBtns.length) return;

    let stopped = false;
    const startFlash = () => {
      if (stopped) return;
      nextBtns.forEach((b) => {
        if (!b.hasAttribute("disabled")) b.classList.add("kp-next-flash");
      });
    };
    const stopFlash = () => {
      stopped = true;
      nextBtns.forEach((b) => b.classList.remove("kp-next-flash"));
    };

    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) startFlash();
          });
        },
        { threshold: 0.4 },
      );
      io.observe(kpSection);
    } else {
      startFlash();
    }

    ["pointerdown", "keydown", "touchstart"].forEach((ev) =>
      kpSection.addEventListener(ev, stopFlash, { passive: true }),
    );
    nextBtns.forEach((b) =>
      b.addEventListener("pointerenter", stopFlash, { passive: true }),
    );
  })();
</script>
