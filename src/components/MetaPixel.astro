---
/**
 * MetaPixel.astro — deferred base pixel (browser PageView only)
 * ────────────────────────────────────────────────────────────────────────
 * Loads the Meta Pixel *after* window.load + requestIdleCallback so it
 * NEVER blocks FCP/LCP (PSI had this at 0 TBT contribution in our audit).
 *
 * fbq() stub is installed synchronously during HTML parse so that any
 * code firing `fbq(...)` before fbevents.js lands (e.g. future
 * conversion pixels) gets queued safely and flushed on load.
 *
 * Events we fire from the browser:
 *   - PageView (here, on every page)
 *
 * Events we do NOT fire from the browser (intentional):
 *   - Lead / CompleteRegistration / Purchase → sent server-side by
 *     PostHog's Meta CAPI destination (richer data, iOS-bypass, no
 *     ad blocker losses). That path is configured in the PostHog UI
 *     under Data Pipeline → Destinations → Meta Ads.
 *
 * Why this is safe (no double-counting on Meta CPA):
 *   Meta does not count PageView toward conversion goals or CPA;
 *   it's a qualifying signal only. So even without an eventID dedup
 *   between browser + CAPI, there's no budget risk.
 *
 * Config:
 *   Set PUBLIC_META_PIXEL_ID (15-16 digit numeric) in .env AND in
 *   wrangler.jsonc vars. If unset, this component renders nothing —
 *   useful for local dev / preview URLs.
 *
 * To get your Pixel ID:
 *   business.facebook.com → Events Manager → pick your pixel →
 *   Settings tab → copy the numeric ID next to "Dataset ID".
 */

const pixelId = import.meta.env.PUBLIC_META_PIXEL_ID;
const testEventCode = import.meta.env.PUBLIC_META_TEST_EVENT_CODE || "";
---

{
  pixelId && (
    <>
      {/*
        Script below is the canonical Meta Pixel stub (same shape as the
        one in Events Manager), wrapped in load/idle-defer so it never
        steals main-thread time from LCP. Do not minify — readability
        matters more than 80 bytes on one tag.
      */}
      <script is:inline define:vars={{ pixelId, testEventCode }}>
        (function () {
          if (window.fbq) return;
          var n = (window.fbq = function () {
            n.callMethod
              ? n.callMethod.apply(n, arguments)
              : n.queue.push(arguments);
          });
          if (!window._fbq) window._fbq = n;
          n.push = n;
          n.loaded = true;
          n.version = "2.0";
          n.queue = [];

          function boot() {
            var t = document.createElement("script");
            t.async = true;
            t.src = "https://connect.facebook.net/en_US/fbevents.js";
            var s = document.getElementsByTagName("script")[0];
            s.parentNode.insertBefore(t, s);

            fbq("init", pixelId);
            // Pass test_event_code when set so this PageView appears in
            // Events Manager → Test Events. The env var is cleared in prod.
            var pageViewOptions = testEventCode
              ? [{}, { test_event_code: testEventCode }]
              : [{}];
            fbq.apply(null, ["track", "PageView"].concat(pageViewOptions));
          }

          function schedule() {
            // 3 s floor keeps Meta Pixel outside the FCP→TTI TBT window.
            setTimeout(function () {
              if ("requestIdleCallback" in window) {
                requestIdleCallback(boot, { timeout: 10000 });
              } else {
                setTimeout(boot, 1000);
              }
            }, 3000);
          }

          if (document.readyState === "complete") {
            schedule();
          } else {
            window.addEventListener("load", schedule, { once: true });
          }
        })();
      </script>
      {/*
        <noscript> fallback: a 1x1 tracking pixel that fires a PageView
        via pure HTML for users with JS disabled (rare, but Meta counts
        them in baseline volume). Only runs when JS is off.
      */}
      <noscript>
        <img
          height="1"
          width="1"
          style="display:none"
          alt=""
          src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`}
        />
      </noscript>
    </>
  )
}
